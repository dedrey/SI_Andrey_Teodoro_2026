@inject ICondicaoPagamentoService CondicaoPagamentoService
@inject IMetodoPagamentoService MetodoPagamentoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(_readOnly ? "Detalhes da Condição de Pagamento" : Edicao ? "Editar Condição de Pagamento" : "Cadastrar Nova Condição de Pagamento")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValido">
            <MudGrid Spacing="2">
                <TituloSecao Grupos="_grupos" Grupo="1" Icone="@Icons.Material.Filled.RequestQuote" Titulo="Condição" AoMudar="StateHasChanged" />
                <MudItem xs="12" sm="2">
                    <MudNumericField T="int" Value="_dto.Id" ValueChanged="@((int v) => { _dto.Id = v; Alterou(1); })"
                                     Label="ID" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" FullWidth="true"
                                     Validation="@((int v) => v <= 0 ? "ID deve ser maior que zero" : null)"
                                     Disabled="@(_dto.IdOriginal > 0 || Bloqueado(1))" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_dto.CondicaoPagamento" ValueChanged="@((string v) => { _dto.CondicaoPagamento = v; Alterou(1); })" Label="Condição de Pagamento" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="50" FullWidth="true" Disabled="@Bloqueado(1)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <div class="d-flex align-center gap-1">
                        <MudAutocomplete T="MetodoPagamentoListDto"
                                         Value="@(_metodos.FirstOrDefault(m => m.Id == _dto.MetodoPagamentoId))"
                                         ValueChanged="OnMetodoAlterado"
                                         SearchFunc="@((s, ct) => Task.FromResult(string.IsNullOrEmpty(s) ? _metodos.AsEnumerable() : _metodos.Where(m => m.MetodoPagamento.Contains(s, StringComparison.OrdinalIgnoreCase) || m.Codigo.Contains(s, StringComparison.OrdinalIgnoreCase))))"
                                         ToStringFunc="@(m => m == null ? "" : $"{m.MetodoPagamento} ({m.Codigo})")"
                                         Label="Método de Pagamento"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" FullWidth="true"
                                         ResetValueOnEmptyText="true" CoerceText="false"
                                         Disabled="@(Bloqueado(1) || !Edicao && !NomeOk)" HelperText="@(Edicao || NomeOk ? null : "Informe o nome da condição primeiro.")"
                                         Placeholder="Digite para pesquisar..." />
                        <MudTooltip Text="Pesquisar método de pagamento">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                           OnClick="PesquisarMetodo" Disabled="@(Bloqueado(1) || !Edicao && !NomeOk)" />
                        </MudTooltip>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudNumericField T="int" Value="_dto.NumeroParcelas"
                                     ValueChanged="OnNumeroParcelas"
                                     Label="Nº de parcelas" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Min="1" Max="999" FullWidth="true"
                                     Immediate="true" Disabled="@(Bloqueado(1) || !Edicao && !MetodoOk || _emUso)"
                                     HelperText="@(_emUso && !_readOnly ? MsgEmUso : Edicao || MetodoOk ? null : NomeOk ? "Selecione o método de pagamento primeiro." : "Informe o nome da condição primeiro.")" />
                </MudItem>

                <TituloSecao Grupos="_grupos" Grupo="2" Icone="@Icons.Material.Filled.CalendarMonth" Titulo="@($"Parcelas ({_dto.Parcelas.Count})")" AoMudar="StateHasChanged">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="OnGerar" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(Bloqueado(2) || _emUso)">
                        Gerar
                    </MudButton>
                </TituloSecao>
                <MudItem xs="12">
                    @if (!_readOnly && (_emUso ? MsgEmUso : AjudaGrupo(2)) is string ajudaParcelas)
                    {
                        <MudText Typo="Typo.caption" Style="color:#888;display:block;margin-bottom:8px;">@ajudaParcelas</MudText>
                    }
                    @if (_dto.Parcelas.Count > 0)
                    {
                        <MudTable Items="@_dto.Parcelas" Dense="true" Elevation="0"
                                  Style="border:1px solid #e9ecef;border-radius:6px;">
                            <HeaderContent>
                                <MudTh Style="font-weight:600;font-size:0.78rem;width:80px;">Parcela</MudTh>
                                <MudTh Style="font-weight:600;font-size:0.78rem;">Dias até vencimento</MudTh>
                                <MudTh Style="font-weight:600;font-size:0.78rem;color:#888;">Vencimento (a partir de hoje)</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Style="font-weight:600;">@context.NumeroParcela</MudTd>
                                <MudTd>
                                    <MudTextField Value="@context.DiasVencimento.ToString()"
                                                  ValueChanged="@((string v) => { context.DiasVencimento = int.TryParse(v, out int d) && d >= 0 ? d : 0; Alterou(2); })"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Immediate="true" Style="max-width:120px;" Placeholder="0 = no ato" Disabled="@(Bloqueado(2) || _emUso)" />
                                </MudTd>
                                <MudTd Style="color:#888;font-size:0.85rem;">
                                    @if (context.DiasVencimento == 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">No ato</MudChip>
                                    }
                                    else
                                    {
                                        @DateTime.Today.AddDays(context.DiasVencimento).ToString("dd/MM/yyyy")
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudText Style="color:#bbb;font-size:0.85rem;padding:4px 0;">
                            Defina o número de parcelas e clique em "Gerar" para configurar os prazos.
                        </MudText>
                    }
                </MudItem>

                <TituloSecao Grupos="_grupos" Grupo="3" Icone="@Icons.Material.Filled.Percent" Titulo="Percentuais" AoMudar="StateHasChanged" />
                @if (!_readOnly && AjudaGrupo(3) is string ajudaPercentuais)
                {
                    <MudItem xs="12" Class="py-0">
                        <MudText Typo="Typo.caption" Style="color:#888;">@ajudaPercentuais</MudText>
                    </MudItem>
                }
                <MudItem xs="6" sm="4"><MudNumericField T="decimal" Value="_dto.EntradaMinimaPercentual" ValueChanged="@((decimal v) => { _dto.EntradaMinimaPercentual = v; Alterou(3); })" HideSpinButtons="true" Label="Entrada mín. (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Format="N2" FullWidth="true" Disabled="@Bloqueado(3)" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField T="decimal" Value="_dto.DescontoPercentual" ValueChanged="@((decimal v) => { _dto.DescontoPercentual = v; Alterou(3); })" HideSpinButtons="true" Label="Desconto (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Format="N2" FullWidth="true" Disabled="@Bloqueado(3)" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField T="decimal" Value="_dto.AcrescimoPercentual" ValueChanged="@((decimal v) => { _dto.AcrescimoPercentual = v; Alterou(3); })" HideSpinButtons="true" Label="Acréscimo (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Format="N2" FullWidth="true" Disabled="@Bloqueado(3)" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField T="decimal" Value="_dto.MultaPercentual" ValueChanged="@((decimal v) => { _dto.MultaPercentual = v; Alterou(3); })" HideSpinButtons="true" Label="Multa (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Format="N2" FullWidth="true" Disabled="@Bloqueado(3)" /></MudItem>
                <MudItem xs="6" sm="4"><MudNumericField T="decimal" Value="_dto.TaxaJurosPercentual" ValueChanged="@((decimal v) => { _dto.TaxaJurosPercentual = v; Alterou(3); })" HideSpinButtons="true" Label="Juros (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Format="N2" FullWidth="true" Disabled="@Bloqueado(3)" /></MudItem>
            </MudGrid>
        </MudForm>
        @if (_dto.AtualizadoEm.HasValue)
        {
            <MudText Style="font-size:0.75rem;color:#999;text-align:right;display:block;margin-top:8px;">
                Alterado em @_dto.AtualizadoEm.Value.ToString("dd/MM/yyyy HH:mm")
                @if (!string.IsNullOrWhiteSpace(_dto.NomeAtualizadoPor))
                {
                    <text> por @_dto.NomeAtualizadoPor</text>
                }
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (_readOnly)
        {
            <MudButton Variant="Variant.Outlined" OnClick="Fechar">Fechar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _readOnly = false)" StartIcon="@Icons.Material.Filled.Edit">
                Editar
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" OnClick="Fechar" Disabled="_salvando">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Salvar" Disabled="@(_salvando || _grupos.Editando.HasValue)">
                @(_salvando ? "Salvando..." : "Salvar")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _snapshot;
    [Parameter] public CondicaoPagamentoDto? DtoEdicao { get; set; }
    [Parameter] public bool SomenteLeitura { get; set; } = false;

    private bool _readOnly;
    private CondicaoPagamentoDto _dto = new();
    private List<MetodoPagamentoListDto> _metodos = new();
    private MudForm _form = null!;
    private bool _formValido;
    private bool _salvando;
    private bool _emUso;
    private GruposProgressivos _grupos = null!;
    private bool? _readOnlyTitulo;
    private const string MsgEmUso = "Condição já utilizada: para mudar as parcelas, inative e cadastre outra.";

    private bool Edicao => _dto.IdOriginal > 0;
    private bool NomeOk => !string.IsNullOrWhiteSpace(_dto.CondicaoPagamento);
    private bool MetodoOk => NomeOk && _dto.MetodoPagamentoId > 0;
    private bool Bloqueado(int g) => _readOnly || _grupos.Bloqueado(g);
    private string? AjudaGrupo(int g) => _grupos.Ajuda(g);
    private void Alterou(int g) => _grupos.Alterou(g);
    private string? ErroGrupo(int g) => g switch
    {
        1 when !NomeOk => "Informe o nome da condição.",
        1 when !MetodoOk => "Selecione o método de pagamento.",
        1 when _dto.NumeroParcelas < 1 => "Informe o número de parcelas.",
        2 when _dto.Parcelas.Count != _dto.NumeroParcelas => "Clique em 'Gerar' para definir os prazos das parcelas.",
        2 when !ValidarParcelasCrescentes(out var erro) => erro,
        3 when new[] { _dto.EntradaMinimaPercentual, _dto.DescontoPercentual, _dto.AcrescimoPercentual, _dto.MultaPercentual, _dto.TaxaJurosPercentual }.Any(p => p < 0 || p > 100)
            => "Os percentuais devem estar entre 0 e 100.",
        _ => null
    };

    protected override void OnAfterRender(bool firstRender)
    {
        if (_readOnlyTitulo == _readOnly) return;
        var jaRenderizado = _readOnlyTitulo.HasValue;
        _readOnlyTitulo = _readOnly;
        if (jaRenderizado) MudDialog.StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _readOnly = SomenteLeitura;
        _grupos = new(() => !_readOnly && !Edicao, ErroGrupo, "a condição", "as parcelas");
        _dto = DtoEdicao != null
            ? new CondicaoPagamentoDto
            {
                Id = DtoEdicao.Id,
                IdOriginal = DtoEdicao.IdOriginal,
                CondicaoPagamento = DtoEdicao.CondicaoPagamento,
                MetodoPagamentoId = DtoEdicao.MetodoPagamentoId,
                NumeroParcelas = DtoEdicao.NumeroParcelas,
                EntradaMinimaPercentual = DtoEdicao.EntradaMinimaPercentual,
                DescontoPercentual = DtoEdicao.DescontoPercentual,
                AcrescimoPercentual = DtoEdicao.AcrescimoPercentual,
                MultaPercentual = DtoEdicao.MultaPercentual,
                TaxaJurosPercentual = DtoEdicao.TaxaJurosPercentual,
                Ativo = DtoEdicao.Ativo,
                AtualizadoEm = DtoEdicao.AtualizadoEm,
                NomeAtualizadoPor = DtoEdicao.NomeAtualizadoPor,
                Parcelas = DtoEdicao.Parcelas.Select(p => new CondicaoPagamentoParcelaDto
                { Id = p.Id, NumeroParcela = p.NumeroParcela, DiasVencimento = p.DiasVencimento }).ToList()
            }
            : new CondicaoPagamentoDto();

        var metodos = await MetodoPagamentoService.ObterTodosAtivosAsync();
        _metodos = metodos.ToList();
        if (_dto.IdOriginal > 0) _emUso = await CondicaoPagamentoService.EmUsoAsync(_dto.IdOriginal);

        if (_dto.Parcelas.Count == 0 && _dto.NumeroParcelas > 0)
            GerarParcelas();
        await _metodos.IncluirSeAusenteAsync(_dto.MetodoPagamentoId, m => m.Id, async id => await MetodoPagamentoService.ObterPorIdAsync(id) is { } m ? new MetodoPagamentoListDto { Id = m.Id, Codigo = m.Codigo, MetodoPagamento = m.MetodoPagamento } : null);
        if (_dto.IdOriginal == 0) _dto.Id = await CondicaoPagamentoService.ObterProximoIdAsync();
        _snapshot = DialogServiceExtensions.Snapshot(_dto);
    }

    private void OnMetodoAlterado(MetodoPagamentoListDto? m)
    {
        if ((m?.Id ?? 0) == _dto.MetodoPagamentoId) return;
        _dto.MetodoPagamentoId = m?.Id ?? 0;
        Alterou(1);
    }

    private void OnGerar()
    {
        GerarParcelas();
        Alterou(2);
    }

    private void OnNumeroParcelas(int valor)
    {
        if (valor == _dto.NumeroParcelas) return;
        Alterou(1);
        _dto.NumeroParcelas = valor;
        while (_dto.Parcelas.Count < valor)
        {
            var n = _dto.Parcelas.Count + 1;
            _dto.Parcelas.Add(new CondicaoPagamentoParcelaDto
            { NumeroParcela = n, DiasVencimento = 30 * n });
        }
        while (_dto.Parcelas.Count > valor)
            _dto.Parcelas.RemoveAt(_dto.Parcelas.Count - 1);
    }

    private void GerarParcelas()
    {
        _dto.Parcelas = Enumerable.Range(1, _dto.NumeroParcelas)
            .Select(n => new CondicaoPagamentoParcelaDto
            {
                NumeroParcela = n,
                DiasVencimento = _dto.NumeroParcelas == 1
                    ? 0
                    : (DateTime.Today.AddMonths(n) - DateTime.Today).Days
            })
            .ToList();
    }

    private async Task Salvar()
    {
        await _form.Validate();
        if (!_formValido) return;
        if (_dto.Parcelas.Count != _dto.NumeroParcelas)
        {
            Snackbar.Add("Clique em 'Gerar' para definir os prazos das parcelas.", Severity.Warning);
            return;
        }
        if (!ValidarParcelasCrescentes(out var erroParcelas))
        {
            Snackbar.Add(erroParcelas, Severity.Warning);
            return;
        }
        _salvando = true;
        var (sucesso, mensagem, id) = await CondicaoPagamentoService.SalvarAsync(_dto);
        _salvando = false;
        Snackbar.Add(mensagem, sucesso ? Severity.Success : Severity.Error);
        if (sucesso) MudDialog.Close(DialogResult.Ok(id));
    }

    private async Task PesquisarMetodo()
    {
        var metodo = await DialogService.PesquisarMetodoPagamentoAsync(MetodoPagamentoService, _dto.MetodoPagamentoId, NovoMetodo);
        if (metodo == null) return;
        _dto.MetodoPagamentoId = _metodos.ObterOuAdicionar(metodo, m => m.Id).Id;
        Alterou(1);
    }

    private async Task<MetodoPagamentoListDto?> NovoMetodo()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroMetodoPagamento>("Novo Método de Pagamento", opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        _metodos = (await MetodoPagamentoService.ObterTodosAtivosAsync()).ToList();
        return _metodos.FirstOrDefault(m => m.Id == id);
    }

    private bool ValidarParcelasCrescentes(out string erro)
    {
        erro = "";
        var ordenadas = _dto.Parcelas.OrderBy(p => p.NumeroParcela).ToList();
        for (int i = 1; i < ordenadas.Count; i++)
        {
            if (ordenadas[i].DiasVencimento <= ordenadas[i - 1].DiasVencimento)
            {
                erro = $"A parcela {ordenadas[i].NumeroParcela} ({ordenadas[i].DiasVencimento} dias) precisa ter um prazo " +
                       $"maior que a parcela {ordenadas[i - 1].NumeroParcela} ({ordenadas[i - 1].DiasVencimento} dias). " +
                       "Cada parcela deve vencer depois da anterior.";
                return false;
            }
        }
        return true;
    }


    private Task Fechar() => DialogService.FecharComConfirmacaoAsync(MudDialog, _readOnly, _snapshot, _dto);
}
