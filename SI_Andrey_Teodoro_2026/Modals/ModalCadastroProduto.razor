    private async Task<CorListDto?> NovaCor()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroCor>("Nova Cor", opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        _cores = (await CorService.ObterTodosAtivosAsync()).ToList();
        return _cores.FirstOrDefault(x => x.Id == id);
    }
