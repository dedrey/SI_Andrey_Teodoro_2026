@inject IDialogService DialogService
@inject IVendaService VendaService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" />
            <MudText Typo="Typo.h6">Cancelar Venda #@VendaId</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_carregando)
        {
            <div class="d-flex justify-center pa-4"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" /></div>
        }
        else if (_totalRecebido > 0)
        {
            <div style="background:#fff3e0;border:1px solid #ffcc80;border-radius:8px;padding:10px 14px;margin-bottom:14px;">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Style="color:#e65100;">
                        @($"Esta venda tem R$ {_totalRecebido:N2} já recebidos do cliente {_nomeCliente}. Será gerado estorno em Contas a Pagar.")
                    </MudText>
                </div>
            </div>
        }
        <MudText Class="mb-4" Style="color:#666;">
            @(_statusVenda == "FINALIZADA"
                ? "O estoque será devolvido e as contas a receber da venda serão canceladas. Informe o motivo do cancelamento; ele ficará salvo para auditoria."
                : "Informe o motivo do cancelamento.")
        </MudText>
        <MudTextField @bind-Value="_motivo"
                      Label="Motivo do cancelamento"
                      Variant="Variant.Outlined"
                      Lines="3"
                      MaxLength="255"
                      Counter="255"
                      FullWidth="true"
                      Immediate="true"
                      Required="true"
                      RequiredError="Informe o motivo"
                      HelperText="@(MotivoCurto ? $"Mínimo de {TamanhoMinimoMotivo} caracteres ({_motivo.Trim().Length}/{TamanhoMinimoMotivo})." : null)" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Fechar" Disabled="_cancelando">Voltar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="Confirmar"
                   Disabled="@(_cancelando || _carregando || MotivoCurto)"
                   Style="font-weight:700;">
            @(_cancelando ? "Cancelando..." : "Confirmar Cancelamento")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _snapshot;
    [Parameter] public int VendaId { get; set; }

    private string _motivo = string.Empty;
    private bool _cancelando;
    private const int TamanhoMinimoMotivo = 15;
    private bool MotivoCurto => _motivo.Trim().Length < TamanhoMinimoMotivo;
    private bool _carregando = true;
    private string _statusVenda = string.Empty;
    private string _nomeCliente = string.Empty;
    private decimal _totalRecebido;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = DialogServiceExtensions.Snapshot(_motivo);
        var resumo = await VendaService.ObterResumoCancelamentoAsync(VendaId);
        if (resumo.HasValue)
            (_statusVenda, _nomeCliente, _totalRecebido) = resumo.Value;
        _carregando = false;
    }

    private async Task Confirmar()
    {
        if (MotivoCurto) return;
        _cancelando = true;
        var (sucesso, mensagem) = await VendaService.CancelarAsync(VendaId, _motivo.Trim());
        _cancelando = false;
        Snackbar.Add(mensagem, sucesso ? Severity.Success : Severity.Error);
        if (sucesso) MudDialog.Close(DialogResult.Ok(true));
    }

    private Task Fechar() => DialogService.FecharComConfirmacaoAsync(MudDialog, false, _snapshot, _motivo);
}
