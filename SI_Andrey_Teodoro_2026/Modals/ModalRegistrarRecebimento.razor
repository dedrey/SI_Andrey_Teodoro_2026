@inject IContaReceberService ContaReceberService
@inject ISnackbar Snackbar
@inject SI_Andrey_Teodoro_2026.Services.ComprovanteStorage ComprovanteStorage

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
            <MudText Typo="Typo.h6">Registrar Recebimento</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="background:#f8f9fa;border-radius:8px;padding:14px 16px;margin-bottom:16px;">
            <div style="font-size:0.68rem;color:#9e9e9e;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Descrição</div>
            <div style="font-size:1rem;font-weight:600;margin-bottom:10px;">@Descricao</div>
            <div class="d-flex gap-4">
                <div>
                    <div style="font-size:0.68rem;color:#9e9e9e;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Valor Original</div>
                    <div style="font-size:0.95rem;font-weight:600;">R$ @ValorOriginal.ToString("N2")</div>
                </div>
                <div>
                    <div style="font-size:0.68rem;color:#9e9e9e;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Saldo Devido</div>
                    <div style="font-size:1.1rem;font-weight:700;color:#e65100;">R$ @ValorSaldo.ToString("N2")</div>
                </div>
            </div>
        </div>

        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <CampoData @bind-Date="_dataRecebimento" PickerMonth="DateTime.Today" Label="Data de Recebimento"
                               Required="true" AutoClose="true" MinDate="_dataVenda" MaxDate="DateTime.Today"
                               Error="@(ErroRecebimento != null)" ErrorText="@ErroRecebimento" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" Value="_valorRecebidoPreview" ValueChanged="@((decimal v) => _valorRecebidoPreview = Math.Max(v, 0))"
                                     Label="Valor Recebido" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"
                                     Required="true" RequiredError="Obrigatório" Validation="@(new Func<decimal, string?>(v => v > 0 ? null : "Obrigatório"))"
                                     Min="0" Format="N2" Culture="@_culturaBr" FullWidth="true"
                                     Adornment="Adornment.Start" AdornmentText="R$"
                                  HelperText="Pode ser parcial — saldo restante fica aberto" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_observacao" Label="Observação (opcional)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="150" FullWidth="true" />
                </MudItem>
            </MudGrid>

            @if (_valorRecebidoPreview > 0 && _valorRecebidoPreview < ValorSaldo)
            {
                <div style="background:#fff8e1;border-radius:6px;padding:8px 12px;margin-top:8px;">
                    <MudText Typo="Typo.body2" Style="color:#e65100;">
                        Recebimento parcial: ficará um saldo de R$ @((ValorSaldo - _valorRecebidoPreview).ToString("N2")) em aberto.
                    </MudText>
                </div>
            }

            <MudText Typo="Typo.caption" Style="color:#888;text-transform:uppercase;letter-spacing:1px;font-weight:600;display:block;margin-top:16px;margin-bottom:8px;">
                Comprovante (opcional)
            </MudText>

            @if (_arquivo != null)
            {
                <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:8px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@_arquivo.NomeOriginal</MudText>
                        <MudText Typo="Typo.caption" Style="color:#888;">(@ArquivoHelper.FormatarTamanho(_arquivo.Tamanho))</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="RemoverArquivo" />
                </div>
            }
            else
            {
                <div style="border:2px dashed #c5cae9;border-radius:8px;padding:18px;text-align:center;position:relative;cursor:pointer;">
                    <InputFile OnChange="OnArquivoSelecionado" accept=".pdf,.jpg,.jpeg,.png"
                               style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" />
                    <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Primary" Style="font-size:1.8rem;" />
                    <MudText Typo="Typo.body2" Style="color:#5c6bc0;font-weight:600;margin-top:4px;">
                        Clique para anexar comprovante
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:#aaa;">PDF, JPG ou PNG — máx. 5 MB</MudText>
                </div>
            }
            @if (_carregandoArquivo)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            }
            @if (_erroArquivo != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Style="display:block;margin-top:4px;">@_erroArquivo</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Fechar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Confirmar"
                   Disabled="@(_salvando || _carregandoArquivo)" StartIcon="@Icons.Material.Filled.CheckCircle"
                   Style="font-weight:700;min-width:180px;">
            @(_salvando ? "Salvando..." : "CONFIRMAR RECEBIMENTO")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int ContaReceberId { get; set; }
    [Parameter] public string Descricao { get; set; } = string.Empty;
    [Parameter] public decimal ValorOriginal { get; set; }
    [Parameter] public decimal ValorSaldo { get; set; }

    private MudForm? _form;
    private bool _salvando, _carregandoArquivo;
    private DateTime? _dataRecebimento = DateTime.Today;
    private readonly System.Globalization.CultureInfo _culturaBr = new("pt-BR");
    private decimal _valorRecebidoPreview;
    private string? _observacao;

    private ComprovanteArquivo? _arquivo;
    private string? _erroArquivo;

    private DateTime? _dataVenda;

    protected override async Task OnInitializedAsync()
    {
        _valorRecebidoPreview = ValorSaldo;
        var conta = await ContaReceberService.ObterPorIdAsync(ContaReceberId);
        _dataVenda = conta?.VendaId.HasValue == true ? conta.DataVenda?.Date : null;
    }

    private string? ErroRecebimento =>
        DataHelper.ValidarNaoFutura(_dataRecebimento, "data de recebimento")
        ?? DataHelper.ValidarNaoAnterior(_dataRecebimento, _dataVenda, "data de recebimento", "data da venda");

    private async Task OnArquivoSelecionado(InputFileChangeEventArgs e)
    {
        _erroArquivo = null;
        var arquivo = e.File;
        if (arquivo == null) return;

        _erroArquivo = ComprovanteStorage.Validar(arquivo);
        if (_erroArquivo != null) return;

        _carregandoArquivo = true;
        StateHasChanged();

        (_arquivo, _erroArquivo) = await ComprovanteStorage.LerAsync(arquivo);
        _carregandoArquivo = false;
        StateHasChanged();
    }

    private void RemoverArquivo()
    {
        _arquivo = null;
        _erroArquivo = null;
    }

    private async Task<string?> SalvarArquivoAsync()
        => _arquivo == null ? null : await ComprovanteStorage.SalvarAsync(_arquivo, "recebimento", ContaReceberId);

    private async Task Confirmar()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;
        if (!_dataRecebimento.HasValue) { Snackbar.Add("Informe a data de recebimento.", Severity.Warning); return; }
        if (ErroRecebimento != null) { Snackbar.Add(ErroRecebimento, Severity.Warning); return; }
        if (_valorRecebidoPreview <= 0) { Snackbar.Add("Informe um valor maior que zero.", Severity.Warning); return; }
        if (_valorRecebidoPreview > ValorSaldo) { Snackbar.Add($"Valor não pode ser maior que o saldo (R$ {ValorSaldo:N2}).", Severity.Warning); return; }

        _salvando = true;
        string? caminhoArquivo = null;
        try
        {
            caminhoArquivo = await SalvarArquivoAsync();
        }
        catch (Exception ex)
        {
            _salvando = false;
            Snackbar.Add($"Erro ao salvar o comprovante: {ex.Message}", Severity.Error);
            return;
        }

        var (sucesso, mensagem) = await ContaReceberService.RegistrarRecebimentoAsync(
            ContaReceberId, _dataRecebimento.Value, _valorRecebidoPreview, caminhoArquivo, _observacao);
        _salvando = false;
        Snackbar.Add(mensagem, sucesso ? Severity.Success : Severity.Error);
        if (sucesso) MudDialog.Close(DialogResult.Ok(true));
    }

    private void Fechar() => MudDialog.Cancel();
}
