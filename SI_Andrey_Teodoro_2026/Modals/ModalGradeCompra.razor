@inject IProdutoService ProdutoService
@inject ITamanhoService TamanhoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.GridView" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@(ModoEdicao ? "Editar Itens — Cor × Tamanho" : "Adicionar Itens — Cor × Tamanho")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @foreach (var g in _grades)
        {
            <div class="mb-4" style="border:1px solid #e0e0e0;border-radius:8px;padding:10px 12px;">
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@g.Produto.Produto</MudText>
                    @if (!ModoEdicao)
                    {
                        <MudTooltip Text="Remover produto da lista">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => _grades.Remove(g))" />
                        </MudTooltip>
                    }
                </div>
                @if (g.Variacoes.Count == 0)
                {
                    <div class="d-flex align-center gap-2 pa-3" style="background:#fff8e1;border-radius:8px;color:#8a6d00;">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Este produto não tem tamanhos cadastrados (variações ativas). Cadastre ao menos um tamanho no produto ou remova-o da lista.</MudText>
                    </div>
                }
                else
                {
                    @foreach (var cor in g.Cores)
                    {
                        <div class="d-flex align-center flex-wrap gap-1 mb-2">
                            @if (g.Cores.Count > 1)
                            {
                                <MudText Typo="Typo.body2" Style="font-weight:600;min-width:90px;">@cor.Nome:</MudText>
                            }
                            @foreach (var v in g.Variacoes.Where(v => v.CorId == cor.Id))
                            {
                                var marcado = g.Marcadas.Contains(v.IdOriginal);
                                <MudChip T="int" Size="Size.Small" Color="Color.Primary"
                                         Variant="@(marcado ? Variant.Filled : Variant.Outlined)"
                                         Icon="@(marcado ? Icons.Material.Filled.Check : null)"
                                         OnClick="@(() => Alternar(g, v))">@v.Tamanho</MudChip>
                            }
                        </div>
                    }
                    @if (g.Marcadas.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Style="color:#888;">Selecione ao menos um tamanho.</MudText>
                    }
                }
            </div>
        }

        @if (_carregando)
        {
            <div class="d-flex align-center pa-4" style="color:#999;"><MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />Carregando tamanhos...</div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Fechar" Style="height:40px;">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirmar" Disabled="@(!PodeConfirmar)"
                   StartIcon="@Icons.Material.Filled.Check" Style="height:40px;font-weight:700;">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public List<ProdutoListDto> ProdutosIniciais { get; set; } = new();
    // Modo edição (botão de grade na linha): variações do produto que já estão na compra.
    [Parameter] public List<int>? VariacoesMarcadas { get; set; }

    public class ResultadoGrade
    {
        public ProdutoListDto Produto { get; set; } = null!;
        public List<ProdutoVariacaoDto> Variacoes { get; set; } = new();
    }

    private record Eixo(int Id, string Nome);

    private class Grade
    {
        public ProdutoListDto Produto { get; init; } = null!;
        public List<ProdutoVariacaoDto> Variacoes { get; init; } = new();
        public List<Eixo> Cores { get; init; } = new();
        public HashSet<int> Marcadas { get; } = new();
    }

    private bool ModoEdicao => VariacoesMarcadas != null;
    private bool PodeConfirmar => !_carregando && _grades.Count > 0 && _grades.All(g => g.Marcadas.Count > 0);

    private string? _snapshot;
    private bool _carregando;
    private readonly List<Grade> _grades = new();
    private Dictionary<int, int> _ordemTamanhos = new();

    protected override async Task OnInitializedAsync()
    {
        try { _ordemTamanhos = (await TamanhoService.ObterTodosAtivosAsync()).ToDictionary(t => t.Id, t => t.Ordem); }
        catch (Exception ex) { Snackbar.Add($"Erro ao carregar tamanhos: {ex.Message}", Severity.Error); }
        foreach (var produto in ProdutosIniciais) await AdicionarProduto(produto);
        _snapshot = DialogServiceExtensions.Snapshot(DadosEditaveis());
    }

    private async Task AdicionarProduto(ProdutoListDto produto)
    {
        if (_grades.Any(g => g.Produto.Id == produto.Id)) return;

        _carregando = true;
        StateHasChanged();
        List<ProdutoVariacaoDto> variacoes = new();
        try
        {
            var dto = await ProdutoService.ObterPorIdAsync(produto.Id);
            variacoes = dto?.Variacoes.Where(v => v.Ativo)
                .OrderBy(v => v.Cor)
                .ThenBy(v => _ordemTamanhos.GetValueOrDefault(v.TamanhoId, int.MaxValue))
                .ThenBy(v => v.Tamanho)
                .ToList() ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Erro ao carregar tamanhos: {ex.Message}", Severity.Error); }
        finally { _carregando = false; }

        var grade = new Grade
        {
            Produto = produto,
            Variacoes = variacoes,
            Cores = variacoes.Select(v => new Eixo(v.CorId, v.Cor)).Distinct().ToList()
        };
        if (VariacoesMarcadas != null)
            grade.Marcadas.UnionWith(variacoes.Select(v => v.IdOriginal).Where(VariacoesMarcadas.Contains));

        _grades.Add(grade);
    }

    private static void Alternar(Grade g, ProdutoVariacaoDto v)
    {
        if (!g.Marcadas.Remove(v.IdOriginal)) g.Marcadas.Add(v.IdOriginal);
    }

    private void Confirmar()
    {
        if (!PodeConfirmar) return;
        MudDialog.Close(DialogResult.Ok(_grades.Select(g => new ResultadoGrade
        {
            Produto = g.Produto,
            Variacoes = g.Variacoes.Where(v => g.Marcadas.Contains(v.IdOriginal)).ToList()
        }).ToList()));
    }

    private object DadosEditaveis() => _grades.Select(g => new
    {
        ProdutoId = g.Produto.Id,
        Marcadas = g.Marcadas.OrderBy(id => id).ToList()
    }).ToList();
    private Task Fechar() => DialogService.FecharComConfirmacaoAsync(MudDialog, false, _snapshot, DadosEditaveis());
}
