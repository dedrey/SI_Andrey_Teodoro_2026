@inject IFornecedorService FornecedorService
@inject ICidadeService CidadeService
@inject IPaisService PaisService
@inject ICondicaoPagamentoService CondicaoPagamentoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using SI_Andrey_Teodoro_2026.DTOs
@using SI_Andrey_Teodoro_2026.Services.Interfaces

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
            @(_readOnly ? "Detalhes do Fornecedor" : _dto.IdOriginal == 0 ? "Cadastrar Novo Fornecedor" : "Editar Fornecedor")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValido">
            <MudGrid Spacing="2">
                <TituloSecao Grupos="_grupos" Grupo="1" Icone="@Icons.Material.Filled.Badge" Titulo="Identificação" AoMudar="StateHasChanged" />
                <MudItem xs="12" sm="2">
                    <MudNumericField T="int" Value="_dto.Id" ValueChanged="@((int v) => { _dto.Id = v; Alterou(1); })"
                                     Label="ID" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" FullWidth="true"
                                     Validation="@((int v) => v <= 0 ? "O ID deve ser maior que zero." : null)"
                                     Disabled="@(_dto.IdOriginal > 0 || Bloqueado(1))" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudSelect T="string" Value="@_dto.TipoPessoa" ValueChanged="OnTipoPessoaAlterado"
                               Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                               Disabled="@(Edicao || Bloqueado(1))" HelperText="@AjudaTravado">
                        <MudSelectItem T="string" Value="@("PF")">Pessoa Física</MudSelectItem>
                        <MudSelectItem T="string" Value="@("PJ")">Pessoa Jurídica</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField Value="@_docTexto" ValueChanged="@((string v) => OnDocAlterado(v))"
                                  Label="@(_dto.TipoPessoa == "PF" ? "CPF*" : "CNPJ*")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  MaxLength="@(_dto.TipoPessoa == "PF" ? 14 : 18)" FullWidth="true" Immediate="true"
                                  Validation="@((string v) => ValidarDocumento(v))"
                                  Disabled="@(Edicao || Bloqueado(1))" HelperText="@AjudaTravado" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudTextField Value="@_dto.RazaoSocial" ValueChanged="@((string v) => { _dto.RazaoSocial = v; Alterou(1); })"
                                  Label="@(_dto.TipoPessoa == "PJ" ? "Razão Social" : "Nome")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="100" FullWidth="true" Immediate="true"
                                  Disabled="@(Bloqueado(1) || !Edicao && !DocOk)" HelperText="@AjudaRazao" />
                </MudItem>
                @if (_dto.TipoPessoa == "PJ")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@(_dto.NomeFantasia ?? "")" ValueChanged="@((string v) => { _dto.NomeFantasia = v; Alterou(1); })"
                                      Label="Nome Fantasia" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Required="true" RequiredError="Obrigatório" MaxLength="100" FullWidth="true" Immediate="true" Disabled="@(Bloqueado(1) || !Edicao && !RazaoOk)" HelperText="@AjudaRestante" />
                    </MudItem>
                }
                <TituloSecao Grupos="_grupos" Grupo="2" Icone="@Icons.Material.Filled.Place" Titulo="Endereço" AoMudar="StateHasChanged" />
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center gap-1">
                        <MudAutocomplete T="CidadeListDto" Label="Cidade"
                                         Value="_cidadeSelecionada"
                                         ValueChanged="OnCidadeAlterada"
                                         SearchFunc="PesquisarCidade"
                                         ToStringFunc="@(c => c == null ? "" : $"{c.NomeCidade} ({c.Uf})")"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Clearable="true"
                                         Required="true" RequiredError="Obrigatório"
                                         ResetValueOnEmptyText="true" CoerceText="false" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                        <MudTooltip Text="Pesquisar cidade">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                           OnClick="PesquisarCidadeModal" Disabled="@Bloqueado(2)" />
                        </MudTooltip>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_dto.Endereco" ValueChanged="@((string v) => { _dto.Endereco = v; Alterou(2); })"
                                  Label="Endereço" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Obrigatório"
                                  MaxLength="100" FullWidth="true" Immediate="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudTextField Value="@_dto.Numero" ValueChanged="@((string v) => { _dto.Numero = v; Alterou(2); })"
                                  Label="Número" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="10" FullWidth="true" Immediate="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField Value="@_dto.Bairro" ValueChanged="@((string v) => { _dto.Bairro = v; Alterou(2); })"
                                  Label="Bairro" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Obrigatório"
                                  MaxLength="60" FullWidth="true" Immediate="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField Value="@_dto.Complemento" ValueChanged="@((string v) => { _dto.Complemento = v; Alterou(2); })"
                                  Label="Complemento" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Obrigatório"
                                  MaxLength="50" FullWidth="true" Immediate="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.Cep" ValueChanged="@((string v) => { _dto.Cep = MascaraCep(v); Alterou(2); })"
                                  Label="CEP" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Obrigatório"
                                  MaxLength="9" FullWidth="true" Immediate="true" Validation="@((string v) => DocumentoHelper.ValidarCep(v))"
                                  Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <TituloSecao Grupos="_grupos" Grupo="3" Icone="@Icons.Material.Filled.ContactPhone" Titulo="Contato e Pagamento" AoMudar="StateHasChanged" />
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.Telefone" ValueChanged="@((string v) => { _dto.Telefone = TelefoneHelper.Mascara(v); Alterou(3); })"
                                  Label="Telefone" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="15" FullWidth="true" Immediate="true"
                                  Validation="@((string v) => TelefoneHelper.Validar(v))" Disabled="@Bloqueado(3)" HelperText="@AjudaGrupo(3)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.Email" ValueChanged="@((string v) => { _dto.Email = v; Alterou(3); })" Label="E-mail" Class="sem-maiusculas"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="100" FullWidth="true" Immediate="true"
                                  Validation="@((string v) => ValidarEmail(v))"
                                  InputType="InputType.Email" Disabled="@Bloqueado(3)" HelperText="@AjudaGrupo(3)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center gap-1">
                        <MudAutocomplete T="CondicaoPagamentoListDto" Label="Condição de Pagamento"
                                         Value="@(_condicoes.FirstOrDefault(c => c.Id == _dto.CondicaoPagamentoId))"
                                         ValueChanged="OnCondicaoAlterada"
                                         SearchFunc="@((s, ct) => Task.FromResult(string.IsNullOrEmpty(s) ? _condicoes.AsEnumerable() : _condicoes.Where(c => c.CondicaoPagamento.Contains(s, StringComparison.OrdinalIgnoreCase))))"
                                         ToStringFunc="@(c => c?.CondicaoPagamento ?? "")"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Clearable="true"
                                         Required="true" RequiredError="Obrigatório"
                                         ResetValueOnEmptyText="true" CoerceText="false" Disabled="@Bloqueado(3)" HelperText="@AjudaGrupo(3)" />
                        <MudTooltip Text="Pesquisar condição de pagamento">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                           OnClick="PesquisarCondicao" Disabled="@Bloqueado(3)" />
                        </MudTooltip>
                    </div>
                </MudItem>
            </MudGrid>
        </MudForm>
        @if (_dto.AtualizadoEm.HasValue)
        {
            <MudText Style="font-size:0.75rem;color:#999;text-align:right;display:block;margin-top:8px;">
                Alterado em @_dto.AtualizadoEm.Value.ToString("dd/MM/yyyy HH:mm")
                @if (!string.IsNullOrWhiteSpace(_dto.NomeAtualizadoPor))
                {
                    <text> por @_dto.NomeAtualizadoPor</text>
                }
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (_readOnly)
        {
            <MudButton OnClick="Cancelar" Variant="Variant.Text">Fechar</MudButton>
            <MudButton OnClick="@(() => _readOnly = false)" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit">
                Editar
            </MudButton>
        }
        else
        {
            <MudButton OnClick="Cancelar" Variant="Variant.Text" Disabled="_salvando">Cancelar</MudButton>
            <MudButton OnClick="Salvar" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="@(_salvando || _grupos.Editando.HasValue)" StartIcon="@Icons.Material.Filled.Save">
                @(_salvando ? "Salvando..." : "Salvar")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _snapshot;
    [Parameter] public FornecedorDto? DtoEdicao { get; set; }
    [Parameter] public bool SomenteLeitura { get; set; } = false;

    private bool _readOnly;
    private FornecedorDto _dto = new();
    private MudForm _form = null!;
    private bool _formValido, _salvando;
    private string _docTexto = "";
    private List<CidadeListDto> _cidades = new();
    private CidadeListDto? _cidadeSelecionada;
    private int _brasilId;
    private List<CondicaoPagamentoListDto> _condicoes = new();
    private GruposProgressivos _grupos = null!;
    private bool? _readOnlyTitulo;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_readOnlyTitulo == _readOnly) return;
        var jaRenderizado = _readOnlyTitulo.HasValue;
        _readOnlyTitulo = _readOnly;
        if (jaRenderizado) MudDialog.StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _readOnly = SomenteLeitura;
        _grupos = new(() => !_readOnly && !Edicao, ErroGrupo, "a identificação", "o endereço");
        _brasilId = await PaisService.ObterIdBrasilAsync();
        _cidades = (await CidadeService.ObterTodosAtivosSemPaginacaoAsync())
            .Where(c => c.PaisId == _brasilId).ToList();
        _condicoes = (await CondicaoPagamentoService.ObterTodosAtivosAsync()).ToList();
        if (DtoEdicao is not null)
        {
            _dto = new FornecedorDto
            {
                Id = DtoEdicao.Id,
                IdOriginal = DtoEdicao.IdOriginal,
                RazaoSocial = DtoEdicao.RazaoSocial,
                TipoPessoa = DtoEdicao.TipoPessoa,
                NomeFantasia = DtoEdicao.NomeFantasia,
                CpfCnpj = DtoEdicao.CpfCnpj,
                CidadeId = DtoEdicao.CidadeId,
                Endereco = DtoEdicao.Endereco,
                Numero = DtoEdicao.Numero,
                Complemento = DtoEdicao.Complemento,
                Bairro = DtoEdicao.Bairro,
                Cep = DtoEdicao.Cep,
                Telefone = TelefoneHelper.Mascara(DtoEdicao.Telefone),
                Email = DtoEdicao.Email ?? "",
                CondicaoPagamentoId = DtoEdicao.CondicaoPagamentoId,
                NomeCondicaoPagamento = DtoEdicao.NomeCondicaoPagamento,
                Ativo = DtoEdicao.Ativo,
                AtualizadoEm = DtoEdicao.AtualizadoEm,
                NomeAtualizadoPor = DtoEdicao.NomeAtualizadoPor
            };
            _docTexto = DtoEdicao.CpfCnpj;
            await _cidades.IncluirSeAusenteAsync(_dto.CidadeId, c => c.Id, async id => await CidadeService.ObterPorIdAsync(id) is { } c ? new CidadeListDto { Id = c.Id, NomeCidade = c.NomeCidade, EstadoId = c.EstadoId, PaisId = c.PaisId, Uf = c.Uf } : null);
            if (_dto.CidadeId.HasValue) _cidadeSelecionada = _cidades.FirstOrDefault(c => c.Id == _dto.CidadeId);
            if (_dto.CondicaoPagamentoId.HasValue && _condicoes.All(c => c.Id != _dto.CondicaoPagamentoId))
                _condicoes.Add(new CondicaoPagamentoListDto { Id = _dto.CondicaoPagamentoId.Value, CondicaoPagamento = _dto.NomeCondicaoPagamento });
        }
        if (_dto.IdOriginal == 0) _dto.Id = await FornecedorService.ObterProximoIdAsync();
        _snapshot = DialogServiceExtensions.Snapshot(DadosEditaveis());
    }

    private async Task PesquisarCondicao()
    {
        var condicao = await DialogService.PesquisarCondicaoPagamentoAsync(CondicaoPagamentoService, _dto.CondicaoPagamentoId, NovaCondicao);
        if (condicao == null) return;
        _dto.CondicaoPagamentoId = _condicoes.ObterOuAdicionar(condicao, c => c.Id).Id;
        Alterou(3);
    }

    private async Task<CondicaoPagamentoListDto?> NovaCondicao()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroCondicaoPagamento>("Nova Condição de Pagamento", opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        _condicoes = (await CondicaoPagamentoService.ObterTodosAtivosAsync()).ToList();
        return _condicoes.FirstOrDefault(c => c.Id == id);
    }

    private Task<IEnumerable<CidadeListDto>> PesquisarCidade(string? busca, CancellationToken ct)
    {
        var r = string.IsNullOrWhiteSpace(busca) ? _cidades.Take(50)
            : _cidades.Where(c => c.NomeCidade.Contains(busca, StringComparison.OrdinalIgnoreCase) || c.Uf.Contains(busca, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r);
    }

    private async Task PesquisarCidadeModal()
    {
        var cidade = await DialogService.PesquisarCidadeAsync(CidadeService, _dto.CidadeId, NovaCidade, _brasilId);
        if (cidade == null) return;
        _cidadeSelecionada = _cidades.ObterOuAdicionar(cidade, c => c.Id);
        _dto.CidadeId = _cidadeSelecionada.Id;
        Alterou(2);
    }

    private async Task<CidadeListDto?> NovaCidade()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var param = new DialogParameters<ModalCadastroCidade> { { x => x.PaisIdInicial, _brasilId } };
        var dialog = await DialogService.ShowAsync<ModalCadastroCidade>("Nova Cidade", param, opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        var todas = (await CidadeService.ObterTodosAtivosSemPaginacaoAsync()).ToList();
        _cidades = todas.Where(c => c.PaisId == _brasilId).ToList();
        return todas.FirstOrDefault(c => c.Id == id);
    }

    private async Task Salvar()
    {
        await _form.Validate();
        if (!_formValido) return;
        _salvando = true;
        var (sucesso, mensagem, id) = await FornecedorService.SalvarAsync(_dto);
        _salvando = false;
        if (sucesso) { Snackbar.Add(mensagem, Severity.Success); MudDialog.Close(DialogResult.Ok(id)); }
        else Snackbar.Add(mensagem, Severity.Error);
    }
    private bool Edicao => _dto.IdOriginal > 0;
    private string? AjudaTravado => Edicao && !_readOnly ? "Não pode ser alterado após o cadastro." : null;
    private bool DocOk => Edicao || DocumentoHelper.DocumentoValido(_dto.CpfCnpj, _dto.TipoPessoa);
    private bool RazaoOk => DocOk && !string.IsNullOrWhiteSpace(_dto.RazaoSocial);
    private string? AjudaRazao => Edicao || DocOk ? null : $"Informe um {(_dto.TipoPessoa == "PF" ? "CPF" : "CNPJ")} válido primeiro.";
    private string? AjudaRestante => Edicao || RazaoOk ? null : AjudaRazao ?? $"Informe {(_dto.TipoPessoa == "PJ" ? "a razão social" : "o nome")} primeiro.";
    private bool Bloqueado(int g) => _readOnly || _grupos.Bloqueado(g);
    private string? AjudaGrupo(int g) => _grupos.Ajuda(g);
    private string? ErroGrupo(int g) => g switch
    {
        1 when !DocOk => $"Informe um {(_dto.TipoPessoa == "PF" ? "CPF" : "CNPJ")} válido.",
        1 when !RazaoOk => $"Informe {(_dto.TipoPessoa == "PJ" ? "a razão social" : "o nome")}.",
        1 when _dto.TipoPessoa == "PJ" && string.IsNullOrWhiteSpace(_dto.NomeFantasia) => "Informe o nome fantasia.",
        2 when !_dto.CidadeId.HasValue => "Selecione a cidade.",
        2 when string.IsNullOrWhiteSpace(_dto.Endereco) => "Informe o endereço.",
        2 when string.IsNullOrWhiteSpace(_dto.Numero) => "Informe o número.",
        2 when string.IsNullOrWhiteSpace(_dto.Bairro) => "Informe o bairro.",
        2 when string.IsNullOrWhiteSpace(_dto.Complemento) => "Informe o complemento.",
        2 when string.IsNullOrWhiteSpace(_dto.Cep) => "Informe o CEP.",
        2 when !DocumentoHelper.CepValido(_dto.Cep) => "CEP incompleto.",
        3 when TelefoneHelper.Validar(_dto.Telefone) is string erro => $"Telefone: {erro}.",
        3 when ValidarEmail(_dto.Email) is string erro => $"E-mail: {erro}.",
        3 when !_dto.CondicaoPagamentoId.HasValue => "Selecione a condição de pagamento.",
        _ => null
    };
    private void Alterou(int g) => _grupos.Alterou(g);
    private void OnCidadeAlterada(CidadeListDto? c)
    {
        if (c?.Id == _dto.CidadeId) return;
        _cidadeSelecionada = c;
        _dto.CidadeId = c?.Id;
        Alterou(2);
    }
    private void OnCondicaoAlterada(CondicaoPagamentoListDto? c)
    {
        if (c?.Id == _dto.CondicaoPagamentoId) return;
        _dto.CondicaoPagamentoId = c?.Id;
        Alterou(3);
    }
    private object DadosEditaveis() => new { _dto, _docTexto, Cidade = _cidadeSelecionada?.Id };
    private Task Cancelar() => DialogService.FecharComConfirmacaoAsync(MudDialog, _readOnly, _snapshot, DadosEditaveis());
    private void OnTipoPessoaAlterado(string tipo) { if (tipo == _dto.TipoPessoa) return; Alterou(1); _dto.TipoPessoa = tipo; _docTexto = ""; _dto.CpfCnpj = ""; if (tipo == "PF") _dto.NomeFantasia = null; }
    private void OnDocAlterado(string? v) { Alterou(1); if (string.IsNullOrEmpty(v)) { _docTexto = ""; _dto.CpfCnpj = ""; return; } var limpo = DocumentoHelper.SomenteDigitos(v); _docTexto = _dto.TipoPessoa == "PF" ? DocumentoHelper.FormatarCpf(limpo) : DocumentoHelper.FormatarCnpj(limpo); _dto.CpfCnpj = limpo; }
    private string? ValidarDocumento(string? v) => DocumentoHelper.ValidarDocumento(v, _dto.TipoPessoa);
    private string MascaraCep(string? v)
    {
        if (string.IsNullOrEmpty(v)) return "";
        var d = DocumentoHelper.SomenteDigitos(v);
        if (d.Length > 8) d = d[..8];
        return d.Length <= 5 ? d : $"{d[..5]}-{d[5..]}";
    }
    private static string? ValidarEmail(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return "Obrigatório";
        return System.Text.RegularExpressions.Regex.IsMatch(v, @"^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$") ? null : "E-mail inválido";
    }
}
