@inject ICompraService CompraService
@inject IFornecedorService FornecedorService
@inject ITransportadoraService TransportadoraService
@inject IProdutoService ProdutoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@(SomenteLeitura ? "Visualizar Compra" : "Nova Compra")</MudText>
            @if (ImportarXmlVisivel)
            {
                <MudFileUpload @ref="_uploadXml" T="IBrowserFile" Accept=".xml" FilesChanged="ImportarXml" Class="ml-auto mr-8 mt-0">
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_importandoXml"
                                   OnClick="@context.OpenFilePickerAsync">
                            @(_importandoXml ? "Importando..." : "Importar XML")
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValido">
            @if (SomenteLeitura && _dto.StatusCompra == "CANCELADO")
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    <strong>Compra cancelada:</strong> @_dto.MotivoCancelamento
                </MudAlert>
            }
            <MudGrid Spacing="2">
                <MudItem xs="10" sm="5">
                    <MudAutocomplete T="FornecedorListDto"
                                     Value="@(_fornecedores.FirstOrDefault(f => f.Id == _dto.FornecedorId))"
                                     ValueChanged="@((FornecedorListDto? f) => OnFornecedorAlterado(f))"
                                     SearchFunc="@((s, ct) => Task.FromResult(string.IsNullOrEmpty(s) ? _fornecedores.AsEnumerable() : _fornecedores.Where(f => f.RazaoSocial.Contains(s, StringComparison.OrdinalIgnoreCase))))"
                                     ToStringFunc="@(f => f?.RazaoSocial ?? "")"
                                     Label="Fornecedor" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                     Required="true" RequiredError="Selecione um fornecedor"
                                     ResetValueOnEmptyText="true" CoerceText="false" Disabled="@(SomenteLeitura || CabecalhoBloqueado)" />
                </MudItem>
                <MudItem xs="2" sm="1" Class="d-flex align-end pb-1">
                    <MudTooltip Text="Novo fornecedor">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Medium"
                                       OnClick="AbrirModalFornecedor" Disabled="@(SomenteLeitura || CabecalhoBloqueado)" />
                    </MudTooltip>
                </MudItem>
                <MudItem xs="10" sm="5">
                    <MudAutocomplete T="TransportadoraListDto"
                                     Value="@(_transportadoras.FirstOrDefault(t => t.Id == _dto.TransportadoraId))"
                                     ValueChanged="@((TransportadoraListDto? t) => _dto.TransportadoraId = t?.Id)"
                                     SearchFunc="@((s, ct) => Task.FromResult(string.IsNullOrEmpty(s) ? _transportadoras.AsEnumerable() : _transportadoras.Where(t => t.RazaoSocial.Contains(s, StringComparison.OrdinalIgnoreCase))))"
                                     ToStringFunc="@(t => t?.RazaoSocial ?? "")"
                                     Label="Transportadora" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                     Required="true" RequiredError="Selecione uma transportadora"
                                     ResetValueOnEmptyText="true" CoerceText="false" Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue || CabecalhoBloqueado)" />
                </MudItem>
                <MudItem xs="2" sm="1" Class="d-flex align-end pb-1">
                    <MudTooltip Text="Nova transportadora">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" Size="Size.Medium"
                                       OnClick="AbrirModalTransportadora" Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue || CabecalhoBloqueado)" />
                    </MudTooltip>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudSelect T="string" @bind-Value="_dto.ModeloNf" Label="Modelo"
                               Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                               Required="true" RequiredError="Selecione o modelo"
                               Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue || CabecalhoBloqueado)">
                        <MudSelectItem T="string" Value="@("55")">55 - NF-E</MudSelectItem>
                        <MudSelectItem T="string" Value="@("65")">65 - NFC-E</MudSelectItem>
                        <MudSelectItem T="string" Value="@("01")">01 - NOTA FISCAL MODELO 1/1A</MudSelectItem>
                        <MudSelectItem T="string" Value="@("04")">04 - NOTA FISCAL DE PRODUTOR</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField T="int?" @bind-Value="_dto.SerieNf" Label="Série"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                     Min="0" Max="999" HideSpinButtons="true"
                                     Required="true" RequiredError="Obrigatório"
                                     Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue || CabecalhoBloqueado)" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudTextField T="string" @bind-Value="_dto.NumeroNf" Label="Número"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                  Mask="@(new PatternMask("000000000"))"
                                  Required="true" RequiredError="Obrigatório"
                                  Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue || CabecalhoBloqueado)" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudTextField T="string" Value="@_chaveTexto" ValueChanged="OnChaveAlterada" Label="Chave de acesso"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" Immediate="true" MaxLength="54"
                                  Error="@(ErroChave != null)" ErrorText="@ErroChave" HelperText="@AvisoChave"
                                  Disabled="@(SomenteLeitura || CabecalhoBloqueado)" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudDatePicker @bind-Date="_dataEmissao" @bind-Date:after="OnDataEmissaoAlterada" @bind-PickerMonth="_mesEmissao"
                                   Label="Data de Emissão" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Required="true" RequiredError="Obrigatório" Editable="true"
                                   Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Placeholder="dd/mm/aaaa"
                                   AutoClose="true" MaxDate="DateTime.Today"
                                   Error="@(ErroEmissao != null)" ErrorText="@ErroEmissao"
                                   Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue || CabecalhoBloqueado)" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudDatePicker @bind-Date="_dataChegada" @bind-PickerMonth="_mesChegada"
                                   Label="Data de Chegada" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Required="true" RequiredError="Obrigatório" Editable="true"
                                   Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Placeholder="dd/mm/aaaa"
                                   AutoClose="true" MinDate="_dataEmissao" MaxDate="DateTime.Today"
                                   Error="@(ErroChegada != null)" ErrorText="@ErroChegada"
                                   Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue || CabecalhoBloqueado)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Value="@_dto.NomeCondicaoPagamento"
                                  Label="Condição de Pagamento" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                  ReadOnly="true" Disabled="@(SomenteLeitura || !_dto.FornecedorId.HasValue)"
                                  Error="@(ErroCondicao != null)" ErrorText="@ErroCondicao"
                                  HelperText="Definida no cadastro do fornecedor." />
                </MudItem>
            </MudGrid>
            @if (CabecalhoBloqueado && !SomenteLeitura)
            {
                <MudText Typo="Typo.caption" Style="color:#888;">Remova os itens para alterar os dados da nota.</MudText>
            }
            @if (!CabecalhoValido && !SomenteLeitura)
            {
                <MudText Typo="Typo.caption" Style="color:#888;">Preencha fornecedor, transportadora, dados da nota e datas válidas para adicionar itens.</MudText>
            }

            <MudDivider Class="my-4" />
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;text-transform:uppercase;letter-spacing:1px;color:#888;">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" Class="mr-1" />Itens da Compra
                </MudText>
                @if (!ItensTravados)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="AdicionarItem"
                               Disabled="@(ItensTravados || !CabecalhoValido)">
                        Adicionar Item
                    </MudButton>
                }
            </div>

            @if (!_dto.FornecedorId.HasValue)
            {
                <div class="d-flex align-center justify-center pa-4" style="border:1px dashed #ddd;border-radius:8px;color:#bbb;">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                    <MudText Typo="Typo.body2">Selecione o fornecedor para liberar os itens da compra.</MudText>
                </div>
            }
            else if (_dto.Itens.Count > 0)
            {
                <MudTable Items="@_dto.Itens" Dense="true" Hover="false" Elevation="0" Style="border:1px solid #f0f0f0;border-radius:8px;">
                    <HeaderContent>
                        <MudTh Style="font-weight:600;">Produto</MudTh>
                        <MudTh Style="font-weight:600;">Variação</MudTh>
                        <MudTh Style="font-weight:600;text-align:center;">Quantidade</MudTh>
                        <MudTh Style="font-weight:600;text-align:right;">Custo Unit. (R$)</MudTh>
                        <MudTh Style="font-weight:600;text-align:right;">Desc. %</MudTh>
                        <MudTh Style="font-weight:600;text-align:right;">Desc. R$</MudTh>
                        @if (SomenteLeitura)
                        {
                            <MudTh Style="font-weight:600;text-align:right;">Custo Efetivo</MudTh>
                        }
                        <MudTh Style="font-weight:600;text-align:right;white-space:nowrap;min-width:120px;">Total</MudTh>
                        @if (!ItensTravados)
                        {
                            <MudTh Style="font-weight:600;text-align:center;">Ação</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudAutocomplete T="ProdutoListDto"
                                             Value="_produtosSelecionados.GetValueOrDefault(context)"
                                             ValueChanged="@((ProdutoListDto? p) => OnProdutoAlterado(context, p))"
                                             SearchFunc="PesquisarProduto" ToStringFunc="@(p => p == null ? "" : p.Produto)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                             Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" Disabled="@ItensTravados" />
                        </MudTd>
                        <MudTd>
                            <MudAutocomplete T="ProdutoVariacaoDto"
                                             Value="@(_variacoesPorItem.TryGetValue(context, out var vs2) ? vs2.FirstOrDefault(v => v.IdOriginal == context.ProdutoVariacaoId) : null)"
                                             ValueChanged="@((ProdutoVariacaoDto? v) => OnVariacaoAlterada(context, v?.IdOriginal ?? 0))"
                                             SearchFunc="@((s, ct) => { _variacoesPorItem.TryGetValue(context, out var vlist); var all = vlist ?? new(); return Task.FromResult(string.IsNullOrEmpty(s) ? all.AsEnumerable() : all.Where(v => $"{v.Cor} {v.Tamanho}".Contains(s, StringComparison.OrdinalIgnoreCase))); })"
                                             ToStringFunc="@(v => v == null ? "" : $"{v.Cor} / {v.Tamanho}")"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                             Disabled="@(ItensTravados || !_variacoesPorItem.ContainsKey(context) || _variacoesPorItem[context].Count == 0)"
                                             ResetValueOnEmptyText="true" CoerceText="false" />
                        </MudTd>
                        <MudTd Style="text-align:center;">
                            <MudTextField Value="@context.Quantidade.ToString()" ValueChanged="@((string v) => OnQtdAlterada(context, v))"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="max-width:80px;" Disabled="@ItensTravados" />
                        </MudTd>
                        <MudTd>
                            <MudTextField Value="@GetValorTexto(context)" ValueChanged="@((string v) => OnValorAlterado(context, v))"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                          Adornment="Adornment.Start" AdornmentText="R$" Disabled="@ItensTravados" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal" Value="context.DescontoPercentual" ValueChanged="@((decimal v) => OnDescontoPercentualAlterado(context, v))"
                                             HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Adornment="Adornment.End" AdornmentText="%" Class="input-direita mt-0"
                                             Format="N2" FullWidth="true" Disabled="@ItensTravados"
                                             Validation="@(new Func<decimal, string?>(v => ErroPercentual(v)))"
                                             Error="@(ErroPercentual(context.DescontoPercentual) != null)" ErrorText="@ErroPercentual(context.DescontoPercentual)" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal" Value="context.ValorDesconto" ValueChanged="@((decimal v) => OnDescontoValorAlterado(context, v))"
                                             HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Adornment="Adornment.Start" AdornmentText="R$" Class="input-direita mt-0"
                                             Format="N2" FullWidth="true" Disabled="@ItensTravados"
                                             Validation="@(new Func<decimal, string?>(v => ErroDescontoValor(context, v)))"
                                             Error="@(ErroDescontoValor(context, context.ValorDesconto) != null)" ErrorText="@ErroDescontoValor(context, context.ValorDesconto)" />
                        </MudTd>
                        @if (SomenteLeitura)
                        {
                            <MudTd Style="text-align:right;">R$ @context.CustoUnitarioEfetivo.ToString("N2")</MudTd>
                        }
                        <MudTd Style="text-align:right;font-weight:600;white-space:nowrap;min-width:120px;">R$ @TotalItem(context).ToString("N2")</MudTd>
                        @if (!ItensTravados)
                        {
                            <MudTd Style="text-align:center;">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoverItem(context))" />
                            </MudTd>
                        }
                    </RowTemplate>
                    <FooterContent>
                        <MudTd ColSpan="@(SomenteLeitura ? 7 : 6)" Style="text-align:right;font-weight:600;padding:8px 12px;">Total dos itens:</MudTd>
                        <MudTd Style="text-align:right;font-weight:600;white-space:nowrap;">R$ @_dto.Itens.Sum(TotalItem).ToString("N2")</MudTd>
                        @if (!ItensTravados) { <MudTd></MudTd> }
                    </FooterContent>
                </MudTable>

                @if (!SomenteLeitura)
                {
                    <div class="d-flex justify-end mt-2">
                        @if (_itensConfirmados)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit" OnClick="EditarItens">
                                Editar itens
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ConfirmarItens"
                                       Disabled="@(!PodeConfirmarItens)">
                                Confirmar itens
                            </MudButton>
                        }
                    </div>
                }

                @if (DivergenciaXml)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        Total calculado (R$ @_dto.ValorTotal.ToString("N2")) diferente do total da NF no XML (R$ @_totalNotaXml!.Value.ToString("N2")).
                    </MudAlert>
                }

                <MudGrid Spacing="2" Class="mt-2">
                    <MudItem xs="12" md="7" Class="d-flex">
                        <div class="pa-3" style="flex:1;border:1px solid #f0f0f0;border-radius:8px;background:#fafafa;min-width:0;">
                            @if (ExibirParcelas)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight:600;text-transform:uppercase;letter-spacing:1px;color:#888;">
                                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Class="mr-1" />Parcelas
                                </MudText>

                                @if (SomenteLeitura)
                                {
                                    <MudTable Items="@_contasPagar" Dense="true" Hover="false" Elevation="0" Style="border:1px solid #f0f0f0;border-radius:8px;">
                                        <HeaderContent>
                                            <MudTh Style="font-weight:600;">Descrição</MudTh>
                                            <MudTh Style="font-weight:600;">Vencimento</MudTh>
                                            <MudTh Style="font-weight:600;text-align:right;">Valor</MudTh>
                                            <MudTh Style="font-weight:600;text-align:center;">Status</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd>@context.Descricao</MudTd>
                                            <MudTd>@context.DataVencimento.ToString("dd/MM/yyyy")</MudTd>
                                            <MudTd Style="text-align:right;white-space:nowrap;">R$ @context.ValorOriginal.ToString("N2")</MudTd>
                                            <MudTd Style="text-align:center;">
                                                <MudChip T="string" Size="Size.Small" Color="@(context.Status switch { "PAGA" => Color.Success, "CANCELADA" => Color.Default, _ => context.DataVencimento.Date < DateTime.Today ? Color.Error : Color.Warning })">
                                                    @(context.Status switch { "PAGA" => "Paga", "CANCELADA" => "Cancelada", _ => context.DataVencimento.Date < DateTime.Today ? "Em Atraso" : "Aberta" })
                                                </MudChip>
                                            </MudTd>
                                        </RowTemplate>
                                        <FooterContent>
                                            <MudTd ColSpan="2" Style="text-align:right;font-weight:600;padding:8px 12px;">Soma das parcelas:</MudTd>
                                            <MudTd Style="text-align:right;font-weight:600;white-space:nowrap;">R$ @_contasPagar.Sum(c => c.ValorOriginal).ToString("N2")</MudTd>
                                            <MudTd></MudTd>
                                        </FooterContent>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudTable Items="@_parcelas" Dense="true" Hover="false" Elevation="0" Style="border:1px solid #f0f0f0;border-radius:8px;">
                                        <HeaderContent>
                                            <MudTh Style="font-weight:600;">Parcela</MudTh>
                                            <MudTh Style="font-weight:600;">Vencimento</MudTh>
                                            <MudTh Style="font-weight:600;text-align:right;">Valor</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd Style="font-weight:600;">@context.Numero/@_parcelas.Count</MudTd>
                                            <MudTd>@context.DataVencimento?.ToString("dd/MM/yyyy")</MudTd>
                                            <MudTd Style="text-align:right;white-space:nowrap;">R$ @context.Valor.ToString("N2")</MudTd>
                                        </RowTemplate>
                                        <FooterContent>
                                            <MudTd ColSpan="2" Style="text-align:right;font-weight:600;padding:8px 12px;">Soma das parcelas:</MudTd>
                                            <MudTd Style="text-align:right;font-weight:600;white-space:nowrap;">R$ @_parcelas.Sum(p => p.Valor).ToString("N2")</MudTd>
                                        </FooterContent>
                                    </MudTable>
                                    <MudText Typo="Typo.caption" Class="d-block mt-2" Style="color:#888;">
                                        Vencimentos calculados a partir da data de emissão. Ajustes de data são feitos em Contas a Pagar.
                                    </MudText>
                                }
                            }
                            else
                            {
                                <div class="d-flex align-center justify-center pa-4" style="height:100%;color:#999;">
                                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Class="mr-2" />
                                    <MudText Typo="Typo.body2">
                                        @(SomenteLeitura
                                            ? "Compra sem condição de pagamento: nenhuma conta a pagar será gerada."
                                            : "Confirme os itens para ver a prévia das parcelas.")
                                    </MudText>
                                </div>
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="12" md="5" Class="d-flex">
                        <div class="pa-3" style="flex:1;border:1px solid #f0f0f0;border-radius:8px;background:#fafafa;">
                            <div style="display:grid;grid-template-columns:minmax(120px,1fr) minmax(140px,180px);grid-auto-rows:44px;column-gap:16px;align-items:center;">
                                <MudText Typo="Typo.body2">Subtotal (produtos)</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;text-align:right;white-space:nowrap;">R$ @_dto.ValorSubtotal.ToString("N2")</MudText>
                                <MudText Typo="Typo.body2" Style="color:#2e7d32;">Desconto</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight:600;color:#2e7d32;text-align:right;white-space:nowrap;">- R$ @_dto.ValorDesconto.ToString("N2")</MudText>
                                <MudText Typo="Typo.body2">Frete</MudText>
                                <MudNumericField T="decimal" Value="_dto.ValorFrete" ValueChanged="@((decimal v) => OnAcrescimoAlterado(() => _dto.ValorFrete = v))"
                                                 HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Adornment="Adornment.Start" AdornmentText="R$" Class="input-direita mt-0"
                                                 Min="0" Format="N2" FullWidth="true" Disabled="@(SomenteLeitura || !_itensConfirmados)" />
                                <MudText Typo="Typo.body2">Seguro</MudText>
                                <MudNumericField T="decimal" Value="_dto.ValorSeguro" ValueChanged="@((decimal v) => OnAcrescimoAlterado(() => _dto.ValorSeguro = v))"
                                                 HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Adornment="Adornment.Start" AdornmentText="R$" Class="input-direita mt-0"
                                                 Min="0" Format="N2" FullWidth="true" Disabled="@(SomenteLeitura || !_itensConfirmados)" />
                                <MudText Typo="Typo.body2">Outros Acréscimos</MudText>
                                <MudNumericField T="decimal" Value="_dto.ValorOutrosAcrescimos" ValueChanged="@((decimal v) => OnAcrescimoAlterado(() => _dto.ValorOutrosAcrescimos = v))"
                                                 HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Adornment="Adornment.Start" AdornmentText="R$" Class="input-direita mt-0"
                                                 Min="0" Format="N2" FullWidth="true" Disabled="@(SomenteLeitura || !_itensConfirmados)" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;border-top:1px solid #e0e0e0;height:100%;display:flex;align-items:center;">Total da Nota</MudText>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:#1a237e;border-top:1px solid #e0e0e0;height:100%;display:flex;align-items:center;justify-content:flex-end;white-space:nowrap;">R$ @_dto.ValorTotal.ToString("N2")</MudText>
                            </div>
                            @if (!SomenteLeitura && !_itensConfirmados)
                            {
                                <div class="d-flex justify-end mt-1">
                                    <MudText Typo="Typo.caption" Style="color:#888;">Confirme os itens para informar frete, seguro e acréscimos.</MudText>
                                </div>
                            }
                        </div>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <div class="d-flex align-center justify-center pa-4" style="border:1px dashed #ddd;border-radius:8px;color:#bbb;">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" />
                    <MudText Typo="Typo.body2">Clique em "Adicionar Item" para incluir produtos na compra.</MudText>
                </div>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Fechar" Style="height:40px;">@(SomenteLeitura ? "Fechar" : "Cancelar")</MudButton>
        @if (!SomenteLeitura)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Salvar"
                       Disabled="@(_salvando || !_itensConfirmados)" Style="height:40px;font-weight:700;min-width:160px;">
                @(_salvando ? "Lançando..." : "LANÇAR COMPRA")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _snapshot;
    [Parameter] public CompraDto? DtoVisualizacao { get; set; }
    [Parameter] public bool SomenteLeitura { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _dto = DtoVisualizacao ?? new CompraDto();
        _itensConfirmados = SomenteLeitura;
        _dataEmissao = _dto.DataEmissao;
        _dataChegada = _dto.DataChegada;
        _mesEmissao = _dto.DataEmissao ?? DateTime.Today;
        _mesChegada = _dto.DataChegada ?? DateTime.Today;
        _chaveTexto = ChaveNfeHelper.Formatar(_dto.ChaveAcesso);
        try
        {
            await Task.WhenAll(
                Task.Run(async () => _fornecedores = (await FornecedorService.ObterTodosAtivosAsync()).ToList()),
                Task.Run(async () => _transportadoras = (await TransportadoraService.ObterTodosAtivosAsync()).ToList()),
                Task.Run(async () => _produtos = (await ProdutoService.ObterTodosAtivosAsync()).ToList())
            );
        }
        catch (Exception ex) { Snackbar.Add($"Erro ao carregar: {ex.Message}", Severity.Error); }
        if (SomenteLeitura && _dto.Id > 0)
            _contasPagar = await CompraService.ObterContasPagarAsync(_dto.Id);
        foreach (var item in _dto.Itens)
        {
            var produtoMatch = _produtos.FirstOrDefault(p => p.Produto == item.NomeProduto);
            _produtosSelecionados[item] = produtoMatch;
            _valorTextos[item] = item.ValorUnitario > 0 ? item.ValorUnitario.ToString("N2") : "";
            if (produtoMatch != null)
            {
                var prodDto = await ProdutoService.ObterPorIdAsync(produtoMatch.Id);
                _variacoesPorItem[item] = prodDto?.Variacoes.Where(v => v.Ativo).ToList() ?? new();
            }
            else
            {
                _variacoesPorItem[item] = new();
            }
        }
        RecalcularTotais();
        _snapshot = DialogServiceExtensions.Snapshot(DadosEditaveis());
    }

    private MudForm? _form;
    private bool _formValido;
    private bool _salvando;
    private bool _itensConfirmados;
    private bool ItensTravados => SomenteLeitura || _itensConfirmados;
    private bool PodeConfirmarItens => CabecalhoValido
        && _dto.Itens.Count > 0
        && _dto.Itens.All(i => i.ProdutoVariacaoId > 0 && i.Quantidade > 0 && i.ValorUnitario > 0 && !DescontoInvalido(i) && !PercentualInvalido(i))
        && _dto.Itens.Select(i => i.ProdutoVariacaoId).Distinct().Count() == _dto.Itens.Count;
    private CompraDto _dto = new();
    private DateTime? _dataEmissao;
    private DateTime? _dataChegada;
    private DateTime? _mesEmissao = DateTime.Today;
    private DateTime? _mesChegada = DateTime.Today;
    private List<FornecedorListDto> _fornecedores = new();
    private List<TransportadoraListDto> _transportadoras = new();
    private List<CompraParcelaDto> _parcelas = new();
    private List<ContaPagarListDto> _contasPagar = new();
    private bool ExibirParcelas => SomenteLeitura
        ? _contasPagar.Count > 0
        : _dto.CondicaoPagamentoId.HasValue && _itensConfirmados && _dto.ValorTotal > 0;
    private List<ProdutoListDto> _produtos = new();
    private readonly Dictionary<CompraItemDto, List<ProdutoVariacaoDto>> _variacoesPorItem = new();
    private readonly Dictionary<CompraItemDto, ProdutoListDto?> _produtosSelecionados = new();
    private readonly Dictionary<CompraItemDto, string> _valorTextos = new();
    private readonly Dictionary<CompraItemDto, bool> _ultimoDescontoPercentual = new();
    private bool CabecalhoBloqueado => _dto.Itens.Any(i => !i.Removido && _produtosSelecionados.GetValueOrDefault(i) != null);
    private bool ImportarXmlVisivel => !SomenteLeitura && !CabecalhoBloqueado;
    private (bool visivel, bool importando)? _estadoTitulo;

    protected override void OnAfterRender(bool firstRender)
    {
        var estado = (ImportarXmlVisivel, _importandoXml);
        if (_estadoTitulo == estado) return;
        var jaRenderizado = _estadoTitulo.HasValue;
        _estadoTitulo = estado;
        if (jaRenderizado) MudDialog.StateHasChanged();
    }
    private string? ErroEmissao => _dataEmissao.HasValue && _dataEmissao.Value.Date > DateTime.Today
        ? "A data de emissão não pode ser maior que a data atual." : null;
    private string? ErroChegada =>
        _dataChegada.HasValue && _dataChegada.Value.Date > DateTime.Today
            ? "A data de chegada não pode ser maior que a data atual."
        : _dataEmissao.HasValue && _dataChegada.HasValue && _dataChegada.Value.Date < _dataEmissao.Value.Date
            ? "A data de chegada não pode ser anterior à data de emissão."
        : null;
    private string? ErroCondicao => _dto.FornecedorId.HasValue && !_dto.CondicaoPagamentoId.HasValue
        ? "Fornecedor sem condição de pagamento. Atualize o cadastro do fornecedor." : null;
    private bool CabecalhoValido => _dto.FornecedorId.HasValue
        && _dto.CondicaoPagamentoId.HasValue
        && _dto.TransportadoraId.HasValue
        && NotaValida
        && _dataEmissao.HasValue && _dataChegada.HasValue
        && ErroEmissao == null && ErroChegada == null;

    private const long TamanhoMaximoXml = 2 * 1024 * 1024;
    private static readonly string[] ModelosNf = { "55", "65", "01", "04" };
    private string _chaveTexto = string.Empty;
    private string? _avisoChave;
    private decimal? _totalNotaXml;
    private bool _importandoXml;
    private MudFileUpload<IBrowserFile>? _uploadXml;
    private string ChaveDigitos => ChaveNfeHelper.SomenteDigitos(_chaveTexto);
    private string? ErroChave => ChaveDigitos.Length == 44 && !ChaveNfeHelper.Validar(ChaveDigitos) ? "Chave de acesso inválida." : null;
    private string? AvisoChave => _avisoChave
        ?? (ChaveDigitos.Length is > 0 and < 44 ? $"{ChaveDigitos.Length}/44 dígitos" : null);
    private bool NotaValida => ModelosNf.Contains(_dto.ModeloNf)
        && _dto.SerieNf is >= 0 and <= 999
        && !string.IsNullOrEmpty(_dto.NumeroNf) && _dto.NumeroNf.Length <= 9 && _dto.NumeroNf.All(char.IsDigit)
        && (ChaveDigitos.Length == 0 || ChaveNfeHelper.Validar(ChaveDigitos));
    private bool DivergenciaXml => _totalNotaXml.HasValue && _itensConfirmados
        && Math.Round(_dto.ValorTotal, 2) != Math.Round(_totalNotaXml.Value, 2);

    private void OnChaveAlterada(string? texto)
    {
        var chave = ChaveNfeHelper.SomenteDigitos(texto);
        if (chave.Length > 44) chave = chave[..44];
        _chaveTexto = ChaveNfeHelper.Formatar(chave);
        _dto.ChaveAcesso = chave.Length == 0 ? null : chave;
        _avisoChave = null;
        if (!ChaveNfeHelper.Validar(chave)) return;

        var (cnpj, modelo, serie, numero, _, _) = ChaveNfeHelper.Decompor(chave);
        _dto.ModeloNf = modelo;
        _dto.SerieNf = serie;
        _dto.NumeroNf = numero;
        if (_dto.FornecedorId.HasValue) return;

        var fornecedor = _fornecedores.FirstOrDefault(f => ChaveNfeHelper.SomenteDigitos(f.CpfCnpj) == cnpj);
        if (fornecedor != null) OnFornecedorAlterado(fornecedor);
        else _avisoChave = $"Fornecedor com CNPJ {ChaveNfeHelper.FormatarCnpj(cnpj)} não cadastrado.";
    }

    private async Task ImportarXml(IBrowserFile? arquivo)
    {
        if (arquivo == null) return;
        if (arquivo.Size > TamanhoMaximoXml) { Snackbar.Add("O arquivo XML deve ter no máximo 2 MB.", Severity.Warning); return; }

        _importandoXml = true;
        try
        {
            await using var stream = arquivo.OpenReadStream(TamanhoMaximoXml);
            var (sucesso, mensagem, dados) = await CompraService.LerXmlNfeAsync(stream);
            if (!sucesso || dados == null) { Snackbar.Add(mensagem, Severity.Error); return; }
            AplicarXml(dados);
            if (_uploadXml != null) await _uploadXml.ClearAsync();
            Snackbar.Add("XML importado. Confira os dados e adicione os itens.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Erro ao ler o XML: {ex.Message}", Severity.Error); }
        finally { _importandoXml = false; }
    }

    private void AplicarXml(CompraXmlDto dados)
    {
        _chaveTexto = ChaveNfeHelper.Formatar(dados.ChaveAcesso);
        _dto.ChaveAcesso = dados.ChaveAcesso;
        _avisoChave = null;
        _dto.ModeloNf = dados.ModeloNf;
        _dto.SerieNf = dados.SerieNf;
        _dto.NumeroNf = dados.NumeroNf;
        _dataEmissao = dados.DataEmissao;
        _mesEmissao = dados.DataEmissao;
        _dataChegada = DateTime.Today;
        _mesChegada = DateTime.Today;

        var fornecedor = _fornecedores.FirstOrDefault(f => f.Id == dados.FornecedorId);
        OnFornecedorAlterado(fornecedor);
        if (fornecedor == null)
            Snackbar.Add($"Fornecedor {dados.NomeEmitente} (CNPJ {ChaveNfeHelper.FormatarCnpj(dados.CnpjEmitente)}) não cadastrado. Selecione o fornecedor.", Severity.Warning);

        var transportadora = _transportadoras.FirstOrDefault(t => t.Id == dados.TransportadoraId);
        _dto.TransportadoraId = transportadora?.Id;
        if (transportadora == null)
            Snackbar.Add(string.IsNullOrEmpty(dados.CnpjTransportadora)
                ? "O XML não informa transportadora. Selecione a transportadora."
                : $"Transportadora {dados.NomeTransportadora} (CNPJ {ChaveNfeHelper.FormatarCnpj(dados.CnpjTransportadora)}) não cadastrada. Selecione a transportadora.",
                Severity.Warning);

        _dto.ValorFrete = dados.ValorFrete;
        _dto.ValorSeguro = dados.ValorSeguro;
        _dto.ValorOutrosAcrescimos = dados.ValorOutros;
        _totalNotaXml = dados.ValorTotalNota;
        RecalcularTotais();
    }

    private async Task RecalcularParcelas()
    {
        _parcelas = _dto.CondicaoPagamentoId.HasValue && _dataEmissao.HasValue && _dto.ValorTotal > 0
            ? await CompraService.SimularParcelasAsync(_dto.CondicaoPagamentoId.Value, _dataEmissao.Value, _dto.ValorTotal)
            : new();
    }

    private async Task ConfirmarItens()
    {
        _itensConfirmados = true;
        await RecalcularParcelas();
    }

    private void EditarItens()
    {
        _itensConfirmados = false;
        _parcelas = new();
    }

    private async Task OnAcrescimoAlterado(Action atribuir)
    {
        atribuir();
        RecalcularTotais();
        if (_itensConfirmados) await RecalcularParcelas();
    }

    private void OnDataEmissaoAlterada()
    {
        if (_dataChegada.HasValue && _dataEmissao.HasValue && _dataChegada.Value.Date < _dataEmissao.Value.Date)
            _dataChegada = null;
    }

    private void AdicionarItem()
    {
        var item = new CompraItemDto();
        _dto.Itens.Add(item);
        _produtosSelecionados[item] = null;
        _variacoesPorItem[item] = new();
        _valorTextos[item] = "";
        StateHasChanged();
    }
    private void RemoverItem(CompraItemDto item)
    {
        _dto.Itens.Remove(item);
        _produtosSelecionados.Remove(item);
        _variacoesPorItem.Remove(item);
        _valorTextos.Remove(item);
        _ultimoDescontoPercentual.Remove(item);
        RecalcularTotais();
        StateHasChanged();
    }

    private async Task OnProdutoAlterado(CompraItemDto item, ProdutoListDto? produto)
    {
        _produtosSelecionados[item] = produto;
        item.ProdutoVariacaoId = 0; item.NomeProduto = produto?.Produto ?? "";
        if (produto != null)
        {
            var dto = await ProdutoService.ObterPorIdAsync(produto.Id);
            _variacoesPorItem[item] = dto?.Variacoes.Where(v => v.Ativo).ToList() ?? new();
        }
        else _variacoesPorItem[item] = new();
        StateHasChanged();
    }
    private void OnVariacaoAlterada(CompraItemDto item, int variacaoId)
    {
        item.ProdutoVariacaoId = variacaoId;
        if (_variacoesPorItem.TryGetValue(item, out var vars))
        {
            var v = vars.FirstOrDefault(x => x.IdOriginal == variacaoId);
            if (v != null) { item.Cor = v.Cor; item.Tamanho = v.Tamanho; }
        }
        RecalcularTotais();
        StateHasChanged();
    }
    private void OnQtdAlterada(CompraItemDto item, string? v)
    {
        var d = new string((v ?? "").Where(char.IsDigit).ToArray());
        item.Quantidade = int.TryParse(d, out int n) && n > 0 ? n : 0;
        SincronizarDesconto(item);
        RecalcularTotais();
    }
    private string GetValorTexto(CompraItemDto item) { if (!_valorTextos.ContainsKey(item)) _valorTextos[item] = item.ValorUnitario > 0 ? item.ValorUnitario.ToString("N2") : ""; return _valorTextos[item]; }
    private void OnValorAlterado(CompraItemDto item, string? texto)
    {
        if (string.IsNullOrEmpty(texto)) { _valorTextos[item] = ""; item.ValorUnitario = 0; SincronizarDesconto(item); RecalcularTotais(); return; }
        var f = new string(texto.Where(c => char.IsDigit(c) || c == ',' || c == '.').ToArray());
        _valorTextos[item] = f;
        item.ValorUnitario = decimal.TryParse(f.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal d) ? d : 0;
        SincronizarDesconto(item);
        RecalcularTotais();
    }
    private void OnDescontoPercentualAlterado(CompraItemDto item, decimal percentual)
    {
        item.DescontoPercentual = percentual;
        _ultimoDescontoPercentual[item] = true;
        SincronizarDesconto(item);
        RecalcularTotais();
    }
    private void OnDescontoValorAlterado(CompraItemDto item, decimal valor)
    {
        item.ValorDesconto = valor;
        _ultimoDescontoPercentual[item] = false;
        SincronizarDesconto(item);
        RecalcularTotais();
    }
    private void SincronizarDesconto(CompraItemDto item)
    {
        var bruto = item.ValorUnitario * item.Quantidade;
        if (_ultimoDescontoPercentual.GetValueOrDefault(item))
            item.ValorDesconto = Math.Round(bruto * item.DescontoPercentual / 100, 2);
        else
            item.DescontoPercentual = bruto > 0 ? Math.Round(item.ValorDesconto / bruto * 100, 4) : 0;
    }
    private static bool DescontoInvalido(CompraItemDto item) =>
        item.ValorDesconto < 0 || item.ValorDesconto > item.ValorUnitario * item.Quantidade;
    private static bool PercentualInvalido(CompraItemDto item) => ErroPercentual(item.DescontoPercentual) != null;
    private static string? ErroPercentual(decimal percentual) =>
        percentual < 0 || percentual > 100 ? "Entre 0% e 100%." : null;
    private static string? ErroDescontoValor(CompraItemDto item, decimal valor) =>
        valor < 0 ? "Não pode ser negativo."
        : valor > item.ValorUnitario * item.Quantidade ? "Maior que o valor do item."
        : null;
    private static decimal DescontoLimitado(CompraItemDto item) =>
        Math.Clamp(item.ValorDesconto, 0, Math.Max(item.ValorUnitario * item.Quantidade, 0));
    private static decimal TotalItem(CompraItemDto item) =>
        item.ValorUnitario * item.Quantidade - DescontoLimitado(item);
    private Task<IEnumerable<ProdutoListDto>> PesquisarProduto(string? busca, CancellationToken ct)
    {
        var r = string.IsNullOrWhiteSpace(busca) ? _produtos.Take(50) : _produtos.Where(p => p.Produto.Contains(busca, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r);
    }
    private void RecalcularTotais()
    {
        _dto.ValorSubtotal = _dto.Itens.Sum(i => i.ValorUnitario * i.Quantidade);
        _dto.ValorDesconto = _dto.Itens.Sum(DescontoLimitado);
        _dto.ValorTotal = _dto.ValorSubtotal - _dto.ValorDesconto + _dto.ValorFrete + _dto.ValorSeguro + _dto.ValorOutrosAcrescimos;
    }

    private async Task AbrirModalFornecedor()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroFornecedor>("Novo Fornecedor", opts);
        if ((await dialog.Result) is { Canceled: false })
            _fornecedores = (await FornecedorService.ObterTodosAtivosAsync()).ToList();
    }

    private async Task AbrirModalTransportadora()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroTransportadora>("Nova Transportadora", opts);
        if ((await dialog.Result) is { Canceled: false })
            _transportadoras = (await TransportadoraService.ObterTodosAtivosAsync()).ToList();
    }

    private void OnFornecedorAlterado(FornecedorListDto? fornecedor)
    {
        _dto.FornecedorId = fornecedor?.Id;
        _dto.CondicaoPagamentoId = fornecedor?.CondicaoPagamentoId;
        _dto.NomeCondicaoPagamento = fornecedor?.NomeCondicaoPagamento ?? string.Empty;
    }

    private async Task Salvar()
    {
        if (!_itensConfirmados) return;
        if (!_dto.FornecedorId.HasValue) { Snackbar.Add("Selecione um fornecedor.", Severity.Warning); return; }
        if (!_dto.TransportadoraId.HasValue) { Snackbar.Add("Selecione uma transportadora.", Severity.Warning); return; }
        if (_dto.Itens.Count == 0) { Snackbar.Add("Adicione pelo menos um item.", Severity.Warning); return; }
        if (!_dataEmissao.HasValue) { Snackbar.Add("Informe a data de emissão.", Severity.Warning); return; }
        if (_dataEmissao.Value.Date > DateTime.Today) { Snackbar.Add("A data de emissão não pode ser maior que a data atual.", Severity.Warning); return; }
        if (!_dataChegada.HasValue) { Snackbar.Add("Informe a data de chegada.", Severity.Warning); return; }
        if (_dataChegada.Value.Date < _dataEmissao.Value.Date) { Snackbar.Add("A data de chegada não pode ser anterior à data de emissão.", Severity.Warning); return; }

        _dto.DataEmissao = _dataEmissao;
        _dto.DataChegada = _dataChegada;
        _salvando = true;
        var (sucesso, mensagem, _) = await CompraService.SalvarAsync(_dto);
        _salvando = false;
        Snackbar.Add(mensagem, sucesso ? Severity.Success : Severity.Error);
        if (sucesso) MudDialog.Close(DialogResult.Ok(true));
    }
    private object DadosEditaveis() => new { _dto, _dataEmissao, _dataChegada, _totalNotaXml };
    private Task Fechar() => DialogService.FecharComConfirmacaoAsync(MudDialog, SomenteLeitura, _snapshot, DadosEditaveis());
}
