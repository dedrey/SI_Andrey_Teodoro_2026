@inject IContaPagarService ContaPagarService
@inject IFornecedorService FornecedorService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@(_somenteLeitura ? "Visualizar Conta a Pagar" : _dto.IdOriginal != 0 ? "Editar Conta a Pagar" : "Nova Conta a Pagar")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_dto.CompraId.HasValue)
        {
            <div style="background:#e3f2fd;border:1px solid #90caf9;border-radius:8px;padding:10px 14px;margin-bottom:14px;">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Info" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Style="color:#1565c0;">
                        @if (CanceladaComCompra)
                        {
                            @($"Cancelada junto com a Compra #{_dto.CompraId}{(string.IsNullOrWhiteSpace(_dto.NumeroNfCompra) ? "" : $" (NF {_dto.NumeroNfCompra})")}. Motivo: {_dto.MotivoCancelamentoCompra}")
                        }
                        else
                        {
                            @("Gerada automaticamente pela Compra ")
                            @(string.IsNullOrWhiteSpace(_dto.NumeroNfCompra) ? $"#{_dto.CompraId}" : $"(NF {_dto.NumeroNfCompra})")
                        }
                    </MudText>
                </div>
            </div>
        }
        @if (DeVenda)
        {
            <div style="background:#e3f2fd;border:1px solid #90caf9;border-radius:8px;padding:10px 14px;margin-bottom:14px;">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Info" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Style="color:#1565c0;">
                        @($"Estorno gerado pelo cancelamento da Venda #{_dto.VendaId}. Motivo: {_dto.MotivoCancelamentoVenda}")
                    </MudText>
                </div>
            </div>
        }
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                @if (DeVenda)
                {
                    <MudItem xs="12">
                        <MudTextField Value="@($"CLIENTE: {_dto.NomeCliente}")" Label="Favorecido"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" ReadOnly="true" Disabled="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="8">
                        <div class="d-flex align-center gap-1">
                            <MudAutocomplete T="FornecedorListDto"
                                             Value="@(_fornecedores.FirstOrDefault(f => f.Id == _dto.FornecedorId))"
                                             ValueChanged="@((FornecedorListDto? f) => _dto.FornecedorId = f?.Id)"
                                             SearchFunc="@((s, ct) => Task.FromResult(string.IsNullOrEmpty(s) ? _fornecedores.AsEnumerable() : _fornecedores.Where(f => f.RazaoSocial.Contains(s, StringComparison.OrdinalIgnoreCase))))"
                                             ToStringFunc="@(f => f?.RazaoSocial ?? "")"
                                             Label="Fornecedor"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                             ResetValueOnEmptyText="true" CoerceText="false" Clearable="true"
                                             Disabled="@(_somenteLeitura || DaCompra || _semFornecedor)" />
                            <MudTooltip Text="Pesquisar fornecedor">
                                <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                               OnClick="PesquisarFornecedor" Disabled="@(_somenteLeitura || DaCompra || _semFornecedor)" />
                            </MudTooltip>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center">
                        @if (!DaCompra)
                        {
                            <MudCheckBox T="bool" Value="_semFornecedor" ValueChanged="OnSemFornecedorAlterado"
                                         Color="Color.Primary" Label="Sem fornecedor (despesa fixa)" Disabled="@_somenteLeitura" />
                        }
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudTextField Value="@_dto.Descricao" ValueChanged="@((string v) => _dto.Descricao = v)" Label="Descrição"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  Required="true" RequiredError="Obrigatório" MaxLength="150" FullWidth="true"
                                  ReadOnly="@_somenteLeitura" Disabled="@(_somenteLeitura || Travada || !FornecedorOk)" HelperText="@AjudaDescricao"
                                  Placeholder="Ex: Conta de luz, Compra de mercadoria, Aluguel..." />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" Value="_dto.ValorOriginal" ValueChanged="@((decimal v) => _dto.ValorOriginal = Math.Max(v, 0))"
                                     Label="Valor" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true"
                                     Required="true" RequiredError="Obrigatório" Validation="@(new Func<decimal, string?>(v => v > 0 ? null : "Obrigatório"))"
                                     Min="0" Format="N2" Culture="@_culturaBr" FullWidth="true"
                                     Adornment="Adornment.Start" AdornmentText="R$" ReadOnly="@_somenteLeitura"
                                  Disabled="@(_somenteLeitura || Travada || !DescricaoOk)" HelperText="@AjudaValor" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <CampoData @bind-Date="_dataVencimento" @bind-PickerMonth="_mesExibido" Label="Vencimento"
                               Required="@(!_somenteLeitura)" Editable="@(!_somenteLeitura)"
                               ReadOnly="@_somenteLeitura" MinDate="@VencimentoMinimo"
                               Disabled="@(_somenteLeitura || (!Travada && !ValorOk))" HelperText="@AjudaVencimento" />
                </MudItem>
                @if (_dto.Status == "PAGA" && _dto.DataPagamento.HasValue)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField Value="@_dto.DataPagamento.Value.ToString("dd/MM/yyyy")" Label="Data de Pagamento"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" ReadOnly="true" />
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudTextField Value="@StatusHelper.Texto(TipoStatus.Conta, _dto.Status)" Label="Status"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" ReadOnly="true" Disabled="@_somenteLeitura" />
                </MudItem>
            </MudGrid>
            @if (DaCompra)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-2" Style="color:#888;">Valor e fornecedor vêm da Compra #@_dto.CompraId.</MudText>
            }
            else if (DeVenda && !_somenteLeitura)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-2" Style="color:#888;">Valor e favorecido vêm do cancelamento da Venda #@_dto.VendaId. Só o vencimento pode ser alterado.</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Fechar">@(_somenteLeitura ? "Fechar" : "Cancelar")</MudButton>
        @if (!_somenteLeitura)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Salvar"
                       Disabled="_salvando" StartIcon="@Icons.Material.Filled.Save" Style="font-weight:700;min-width:120px;">
                @(_salvando ? "Salvando..." : "SALVAR")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _snapshot;
    [Parameter] public ContaPagarDto? DtoEdicao { get; set; }

    private MudForm? _form;
    private bool _salvando;
    private ContaPagarDto _dto = new();
    private DateTime? _dataVencimento;
    private DateTime? _mesExibido = DateTime.Today;
    private readonly System.Globalization.CultureInfo _culturaBr = new("pt-BR");
    private List<FornecedorListDto> _fornecedores = new();

    private bool _somenteLeitura => DtoEdicao != null && DtoEdicao.Status != "ABERTA";
    private bool DaCompra => _dto.CompraId.HasValue;
    private bool DeVenda => _dto.VendaId.HasValue;
    private bool Travada => DaCompra || DeVenda;
    private DateTime? VencimentoMinimo => DeVenda && !_somenteLeitura ? _dto.CriadoEm?.Date : null;
    private bool CanceladaComCompra => DaCompra && _dto.Status == "CANCELADA" && !string.IsNullOrWhiteSpace(_dto.MotivoCancelamentoCompra);
    private bool _semFornecedor;
    private bool FornecedorOk => Travada || _semFornecedor || _dto.FornecedorId.HasValue;
    private bool DescricaoOk => FornecedorOk && !string.IsNullOrWhiteSpace(_dto.Descricao);
    private bool ValorOk => DescricaoOk && _dto.ValorOriginal > 0;
    private string? AjudaDescricao => Travada || _somenteLeitura || FornecedorOk ? null : "Selecione o fornecedor ou marque \"Sem fornecedor\" primeiro.";
    private string? AjudaValor => Travada || _somenteLeitura || DescricaoOk ? null : AjudaDescricao ?? "Informe a descrição primeiro.";
    private string? AjudaVencimento => Travada || _somenteLeitura || ValorOk ? null : AjudaValor ?? "Informe o valor primeiro.";

    private void OnSemFornecedorAlterado(bool valor)
    {
        _semFornecedor = valor;
        if (valor) _dto.FornecedorId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        _fornecedores = (await FornecedorService.ObterTodosAtivosAsync()).ToList();

        if (DtoEdicao is not null)
        {
            _dto = new ContaPagarDto
            {
                Id = DtoEdicao.Id,
                IdOriginal = DtoEdicao.IdOriginal,
                FornecedorId = DtoEdicao.FornecedorId,
                NomeFornecedor = DtoEdicao.NomeFornecedor,
                CompraId = DtoEdicao.CompraId,
                NumeroNfCompra = DtoEdicao.NumeroNfCompra,
                MotivoCancelamentoCompra = DtoEdicao.MotivoCancelamentoCompra,
                ClienteId = DtoEdicao.ClienteId,
                NomeCliente = DtoEdicao.NomeCliente,
                VendaId = DtoEdicao.VendaId,
                MotivoCancelamentoVenda = DtoEdicao.MotivoCancelamentoVenda,
                CriadoEm = DtoEdicao.CriadoEm,
                Descricao = DtoEdicao.Descricao,
                DataVencimento = DtoEdicao.DataVencimento,
                DataPagamento = DtoEdicao.DataPagamento,
                ValorOriginal = DtoEdicao.ValorOriginal,
                ValorSaldo = DtoEdicao.ValorSaldo,
                Status = DtoEdicao.Status
            };
            _dataVencimento = DtoEdicao.DataVencimento;
            _mesExibido = DtoEdicao.DataVencimento;
            _semFornecedor = !DtoEdicao.CompraId.HasValue && !DtoEdicao.VendaId.HasValue && !DtoEdicao.FornecedorId.HasValue;
        }
        await _fornecedores.IncluirSeAusenteAsync(_dto.FornecedorId, f => f.Id, async id => await FornecedorService.ObterPorIdAsync(id) is { } f ? new FornecedorListDto { Id = f.Id, RazaoSocial = f.RazaoSocial, NomeFantasia = f.NomeFantasia, TipoPessoa = f.TipoPessoa, CpfCnpj = f.CpfCnpj, CondicaoPagamentoId = f.CondicaoPagamentoId, NomeCondicaoPagamento = f.NomeCondicaoPagamento } : null);
        _snapshot = DialogServiceExtensions.Snapshot(DadosEditaveis());
    }

    private async Task PesquisarFornecedor()
    {
        var fornecedor = await DialogService.PesquisarFornecedorAsync(FornecedorService, _dto.FornecedorId, NovoFornecedor);
        if (fornecedor == null) return;
        _dto.FornecedorId = _fornecedores.ObterOuAdicionar(fornecedor, f => f.Id).Id;
    }

    private async Task<FornecedorListDto?> NovoFornecedor()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroFornecedor>("Novo Fornecedor", opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        _fornecedores = (await FornecedorService.ObterTodosAtivosAsync()).ToList();
        return _fornecedores.FirstOrDefault(f => f.Id == id);
    }

    private async Task Salvar()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;
        if (_dto.ValorOriginal <= 0) { Snackbar.Add("Informe um valor maior que zero.", Severity.Warning); return; }
        if (!_dataVencimento.HasValue) { Snackbar.Add("Informe a data de vencimento.", Severity.Warning); return; }

        _dto.DataVencimento = _dataVencimento.Value;
        _salvando = true;
        var (sucesso, mensagem, _) = await ContaPagarService.SalvarAsync(_dto);
        _salvando = false;
        Snackbar.Add(mensagem, sucesso ? Severity.Success : Severity.Error);
        if (sucesso) MudDialog.Close(DialogResult.Ok(true));
    }

    private object DadosEditaveis() => new { _dto, _dataVencimento };
    private Task Fechar() => DialogService.FecharComConfirmacaoAsync(MudDialog, _somenteLeitura, _snapshot, DadosEditaveis());

}
