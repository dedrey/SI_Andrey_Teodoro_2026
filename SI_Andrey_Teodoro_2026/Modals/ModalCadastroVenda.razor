@inject IVendaService VendaService
@inject IClienteService ClienteService
@inject ICondicaoPagamentoService CondicaoPagamentoService
@inject IProdutoService ProdutoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@(Leitura ? "Visualizar Venda" : _dto.IdOriginal > 0 ? "Alterar Venda" : "Nova Venda")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValido">
            @if (_erroFinalizacao != null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => _erroFinalizacao = null)">
                    @_erroFinalizacao
                </MudAlert>
            }
            @if (Leitura && _dto.StatusVenda != "ABERTA")
            {
                <MudAlert Severity="@(_dto.StatusVenda == "CANCELADA" ? Severity.Error : Severity.Success)" Class="mb-3" Dense="true">
                    Venda @_dto.StatusVenda: somente leitura.
                </MudAlert>
            }
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center gap-1">
                        <MudAutocomplete T="ClienteListDto"
                                         Value="@(_clientes.FirstOrDefault(c => c.Id == _dto.ClienteId))"
                                         ValueChanged="@((ClienteListDto? c) => OnClienteAlterado(c?.Id))"
                                         SearchFunc="@((s, ct) => Task.FromResult(string.IsNullOrEmpty(s) ? _clientes.Take(50) : _clientes.Where(c => c.NomeRazaoSocial.Contains(s, StringComparison.OrdinalIgnoreCase))))"
                                         ToStringFunc="@(c => c?.NomeRazaoSocial ?? "")"
                                         Label="Cliente" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                         Required="true" RequiredError="Selecione um cliente"
                                         ResetValueOnEmptyText="true" CoerceText="false" Disabled="@(Leitura || CabecalhoBloqueado)" />
                        <MudTooltip Text="Pesquisar cliente">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                           OnClick="PesquisarCliente" Disabled="@(Leitura || CabecalhoBloqueado)" />
                        </MudTooltip>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center gap-1">
                        <MudAutocomplete T="CondicaoPagamentoListDto"
                                         Value="@(_condicoes.FirstOrDefault(c => c.Id == _dto.CondicaoPagamentoId))"
                                         ValueChanged="@((CondicaoPagamentoListDto? c) => { _dto.CondicaoPagamentoId = c?.Id; _dto.DescontoPercentualAplicado = c?.DescontoPercentual ?? 0; RecalcularTotais(); })"
                                         SearchFunc="@((s, ct) => Task.FromResult(string.IsNullOrEmpty(s) ? _condicoes.AsEnumerable() : _condicoes.Where(c => c.CondicaoPagamento.Contains(s, StringComparison.OrdinalIgnoreCase))))"
                                         ToStringFunc="@(c => c?.CondicaoPagamento ?? "")"
                                         Label="Condição de Pagamento" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                         Required="true" RequiredError="Selecione uma condição"
                                         ResetValueOnEmptyText="true" CoerceText="false" Disabled="@(Leitura || !_dto.ClienteId.HasValue || CabecalhoBloqueado)" />
                        <MudTooltip Text="Pesquisar condição de pagamento">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                           OnClick="PesquisarCondicao" Disabled="@(Leitura || !_dto.ClienteId.HasValue || CabecalhoBloqueado)" />
                        </MudTooltip>
                    </div>
                </MudItem>
            </MudGrid>
            @if (CabecalhoBloqueado && !Leitura)
            {
                <MudText Typo="Typo.caption" Style="color:#888;">
                    @(_dto.IdOriginal > 0 ? "Venda já gravada com itens: cliente e condição de pagamento não podem ser alterados." : "Remova os itens para alterar os dados da venda.")
                </MudText>
            }
            @if (!CabecalhoValido && !Leitura)
            {
                <MudText Typo="Typo.caption" Style="color:#888;">Preencha cliente e condição de pagamento para adicionar itens.</MudText>
            }

            <MudDivider Class="my-4" />
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600;text-transform:uppercase;letter-spacing:1px;color:#888;">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Small" Class="mr-1" />Itens da Venda
                </MudText>
                @if (!Leitura)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="AdicionarItem"
                               Disabled="@(!CabecalhoValido)">
                        Adicionar Item
                    </MudButton>
                }
            </div>

            @if (_dto.Itens.Count == 0 && !CabecalhoValido)
            {
                <div class="d-flex align-center justify-center pa-4" style="border:1px dashed #ddd;border-radius:8px;color:#bbb;">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                    <MudText Typo="Typo.body2">Selecione o cliente e a condição de pagamento para liberar os itens da venda.</MudText>
                </div>
            }
            else if (_dto.Itens.Count > 0)
            {
                <MudTable Items="@_dto.Itens" Dense="true" Hover="false" Elevation="0" Style="border:1px solid #f0f0f0;border-radius:8px;">
                    <HeaderContent>
                        <MudTh Style="font-weight:600;">Produto</MudTh>
                        <MudTh Style="font-weight:600;">Variação</MudTh>
                        <MudTh Style="font-weight:600;text-align:center;">Estoque</MudTh>
                        <MudTh Style="font-weight:600;text-align:center;">Quantidade</MudTh>
                        <MudTh Style="font-weight:600;text-align:right;">Valor Unit. (R$)</MudTh>
                        <MudTh Style="font-weight:600;text-align:right;">Total</MudTh>
                        @if (!Leitura)
                        {
                            <MudTh Style="font-weight:600;text-align:center;">Ação</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="d-flex align-center gap-1">
                                <MudAutocomplete T="ProdutoListDto"
                                                 Value="_produtosSelecionados.GetValueOrDefault(context)"
                                                 ValueChanged="@((ProdutoListDto? p) => OnProdutoAlterado(context, p))"
                                                 SearchFunc="PesquisarProduto" ToStringFunc="@(p => p == null ? "" : p.Produto)"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" Disabled="@Leitura" />
                                <MudTooltip Text="Pesquisar produto">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="@(() => PesquisarProdutoItem(context))" Disabled="@(Leitura || !CabecalhoValido)" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex align-center gap-1">
                                <MudAutocomplete T="ProdutoVariacaoDto"
                                                 Value="@(_variacoesPorItem.TryGetValue(context, out var vs2) ? vs2.FirstOrDefault(v => v.IdOriginal == context.ProdutoVariacaoId) : null)"
                                                 ValueChanged="@((ProdutoVariacaoDto? v) => OnVariacaoAlterada(context, v?.IdOriginal ?? 0))"
                                                 SearchFunc="@((s, ct) => { _variacoesPorItem.TryGetValue(context, out var vlist); var all = vlist ?? new(); return Task.FromResult(string.IsNullOrEmpty(s) ? all.AsEnumerable() : all.Where(v => $"{v.Cor} {v.Tamanho}".Contains(s, StringComparison.OrdinalIgnoreCase))); })"
                                                 ToStringFunc="@(v => v == null ? "" : $"{v.Cor} / {v.Tamanho} ({v.QuantidadeEstoque} un.)")"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                                 Disabled="@VariacaoDesabilitada(context)"
                                                 ResetValueOnEmptyText="true" CoerceText="false" />
                                <MudTooltip Text="Pesquisar variação">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="@(() => PesquisarVariacaoItem(context))" Disabled="@VariacaoDesabilitada(context)" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                        <MudTd Style="text-align:center;">
                            @if (_variacoesPorItem.TryGetValue(context, out var vs) && context.ProdutoVariacaoId > 0)
                            {
                                var estoque = GetEstoqueVar(vs, context.ProdutoVariacaoId);
                                <MudChip T="string" Size="Size.Small" Color="@(estoque > 0 ? Color.Success : Color.Error)">@estoque un.</MudChip>
                            }
                            else
                            {
                                <span style="color:#ccc;">—</span>
                            }
                        </MudTd>
                        <MudTd Style="text-align:center;">
                            <MudTextField Value="@context.Quantidade.ToString()" ValueChanged="@((string v) => OnQtdAlterada(context, v))"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="max-width:80px;" Disabled="@Leitura"
                                          Validation="@(new Func<string, string?>(_ => ErroQuantidade(context)))"
                                          Error="@(ErroQuantidade(context) != null)" ErrorText="@ErroQuantidade(context)" />
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal" Value="context.ValorUnitario" ValueChanged="@((decimal v) => OnValorAlterado(context, v))"
                                             HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Min="0" Format="N2" Culture="@_culturaBr"
                                             Adornment="Adornment.Start" AdornmentText="R$" Disabled="@Leitura"
                                          Error="@AbaixoDoCusto(context)"
                                          ErrorText="@(AbaixoDoCusto(context) ? $"⚠ Abaixo do custo (R$ {CustoDoItem(context):N2})" : "")" />
                            @if (AbaixoDoCusto(context) && GetAlertaFastFashion(context) == "aviso")
                            {
                                <MudText Style="font-size:0.7rem;color:#f59e0b;font-weight:600;">
                                    ⚡ Fast Fashion — venda abaixo do custo permitida
                                </MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align:right;font-weight:600;">R$ @context.ValorTotal.ToString("N2")</MudTd>
                        @if (!Leitura)
                        {
                            <MudTd Style="text-align:center;">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoverItem(context))" />
                            </MudTd>
                        }
                    </RowTemplate>
                    <FooterContent>
                        <MudTd ColSpan="4" Style="text-align:right;font-weight:600;padding:8px 12px;">Subtotal:</MudTd>
                        <MudTd></MudTd>
                        <MudTd Style="text-align:right;font-weight:600;">R$ @_dto.ValorSubtotal.ToString("N2")</MudTd>
                        @if (!Leitura) { <MudTd></MudTd> }
                    </FooterContent>
                </MudTable>

                <div class="d-flex justify-end mt-2 pa-2" style="border:1px solid #f0f0f0;border-radius:8px;background:#fafafa;">
                    <div style="min-width:280px;">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body2">Subtotal</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">R$ @_dto.ValorSubtotal.ToString("N2")</MudText>
                        </div>
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.body2">Desconto (%)</MudText>
                            <MudNumericField T="decimal" Value="_dto.DescontoPercentualAplicado" ValueChanged="OnDescontoPercentualAlterado"
                                             HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Min="0" Max="100" Format="N2" Style="width:110px;" Disabled="@Leitura" />
                        </div>
                        @if (_dto.ValorDesconto != 0)
                        {
                            var ajusteCor = _dto.ValorDesconto > 0 ? "#2e7d32" : "#c62828";
                            var ajusteLabel = _dto.ValorDesconto > 0 ? "Desconto" : "Acréscimo";
                            var ajusteSinal = _dto.ValorDesconto > 0 ? "-" : "+";
                            <div class="d-flex justify-space-between mb-1">
                                <MudText Typo="Typo.body2" Style="@($"color:{ajusteCor};")">@ajusteLabel</MudText>
                                <MudText Typo="Typo.body2" Style="@($"font-weight:600;color:{ajusteCor};")">@ajusteSinal R$ @Math.Abs(_dto.ValorDesconto).ToString("N2")</MudText>
                            </div>
                        }
                        <MudDivider Class="my-1" />
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Total</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:#1a237e;">R$ @_dto.ValorTotal.ToString("N2")</MudText>
                        </div>
                        @{
                            var condSel = _condicoes.FirstOrDefault(c => c.Id == _dto.CondicaoPagamentoId);
                        }
                        @if (condSel != null && condSel.EntradaMinimaPercentual > 0 && _dto.ValorTotal > 0)
                        {
                            var valorEntrada = Math.Round(_dto.ValorTotal * condSel.EntradaMinimaPercentual / 100, 2);
                            var valorRestante = _dto.ValorTotal - valorEntrada;
                            var nParc = condSel.NumeroParcelas;
                            var valorParcela = nParc > 0 ? Math.Round(valorRestante / nParc, 2) : valorRestante;
                            <MudDivider Class="my-1" />
                            <div style="background:#fff8e1;border-radius:6px;padding:8px 10px;margin-top:6px;">
                                <div style="font-size:0.68rem;color:#f59e0b;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">
                                    Resumo de Entrada (@condSel.EntradaMinimaPercentual.ToString("N0")%)
                                </div>
                                <div class="d-flex justify-space-between">
                                    <MudText Style="font-size:0.82rem;">Entrada mínima</MudText>
                                    <MudText Style="font-size:0.82rem;font-weight:700;color:#e65100;">R$ @valorEntrada.ToString("N2")</MudText>
                                </div>
                                <div class="d-flex justify-space-between">
                                    <MudText Style="font-size:0.82rem;">Restante (@nParc x)</MudText>
                                    <MudText Style="font-size:0.82rem;font-weight:600;">R$ @valorParcela.ToString("N2") cada</MudText>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex align-center justify-center pa-4" style="border:1px dashed #ddd;border-radius:8px;color:#bbb;">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Class="mr-2" />
                    <MudText Typo="Typo.body2">Clique em "Adicionar Item" para incluir produtos na venda.</MudText>
                </div>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Fechar" Style="height:40px;">@(Leitura ? "Fechar" : "Cancelar")</MudButton>
        @if (!Leitura)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Salvar"
                       Disabled="_salvando" Style="height:40px;font-weight:700;min-width:160px;">
                @(_salvando ? "Salvando..." : "SALVAR")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="FinalizarVenda"
                       Disabled="_salvando" StartIcon="@Icons.Material.Filled.Check" Style="height:40px;font-weight:700;min-width:160px;">
                @(_salvando ? "Finalizando..." : "FINALIZAR VENDA")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _snapshot;
    [Parameter] public VendaDto? DtoEdicao { get; set; }
    [Parameter] public bool SomenteLeitura { get; set; }
    private bool Leitura => SomenteLeitura || _dto.StatusVenda != "ABERTA";
    private bool CabecalhoBloqueado => _dto.Itens.Any(i => !i.Removido) || _dto.IdOriginal > 0;
    private bool CabecalhoValido => _dto.ClienteId.HasValue && _dto.CondicaoPagamentoId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _dto = DtoEdicao ?? new VendaDto();
        try
        {
            await Task.WhenAll(
                Task.Run(async () => _clientes = (await ClienteService.ObterTodosAtivosAsync()).ToList()),
                Task.Run(async () => _condicoes = (await CondicaoPagamentoService.ObterTodosAtivosAsync()).ToList()),
                Task.Run(async () => _produtos = (await ProdutoService.ObterTodosAtivosAsync()).ToList())
            );
        }
        catch (Exception ex) { Snackbar.Add($"Erro ao carregar: {ex.Message}", Severity.Error); }
        await _clientes.IncluirSeAusenteAsync(_dto.ClienteId, c => c.Id, async id => await ClienteService.ObterPorIdAsync(id) is { } c ? new ClienteListDto { Id = c.Id, NomeRazaoSocial = c.NomeRazaoSocial, ApelidoNomeFantasia = c.ApelidoNomeFantasia, TipoPessoa = c.TipoPessoa, CpfCnpj = c.CpfCnpj, Estrangeiro = c.Estrangeiro, DocumentoEstrangeiro = c.DocumentoEstrangeiro, LimiteCredito = c.LimiteCredito } : null);
        await _condicoes.IncluirSeAusenteAsync(_dto.CondicaoPagamentoId, c => c.Id, async id => await CondicaoPagamentoService.ObterPorIdAsync(id) is { } c ? new CondicaoPagamentoListDto { Id = c.Id, CondicaoPagamento = c.CondicaoPagamento, MetodoPagamentoId = c.MetodoPagamentoId, NumeroParcelas = c.NumeroParcelas, EntradaMinimaPercentual = c.EntradaMinimaPercentual, DescontoPercentual = c.DescontoPercentual, AcrescimoPercentual = c.AcrescimoPercentual, MultaPercentual = c.MultaPercentual, TaxaJurosPercentual = c.TaxaJurosPercentual } : null);
        foreach (var item in _dto.Itens)
            await _produtos.IncluirSeAusenteAsync(item.ProdutoId, p => p.Id, async id => await ProdutoService.ObterPorIdAsync(id) is { } p ? new ProdutoListDto { Id = p.Id, Produto = p.Produto } : null);
        foreach (var item in _dto.Itens)
        {
            var produtoMatch = _produtos.FirstOrDefault(p => item.ProdutoId > 0 ? p.Id == item.ProdutoId : p.Produto == item.NomeProduto);
            _produtosSelecionados[item] = produtoMatch;
            _custoPorItem[item] = 0;
            _dataCompraPorItem[item] = null;
            if (produtoMatch != null)
            {
                var prodDto = await ProdutoService.ObterPorIdAsync(produtoMatch.Id);
                _variacoesPorItem[item] = prodDto?.Variacoes.Where(v => v.Ativo || v.IdOriginal == item.ProdutoVariacaoId).ToList() ?? new();
                var varSelecionada = _variacoesPorItem[item]
                    .FirstOrDefault(v => v.IdOriginal == item.ProdutoVariacaoId);
                if (varSelecionada != null)
                {
                    _custoPorItem[item] = varSelecionada.PrecoCusto;
                    _dataCompraPorItem[item] = varSelecionada.DataUltimaCompra;
                }
            }
            else
            {
                _variacoesPorItem[item] = new();
            }
        }
        RecalcularTotais();
        _snapshot = DialogServiceExtensions.Snapshot(_dto);
    }

    private MudForm? _form;
    private bool _formValido;
    private bool _salvando;
    private bool _gravada;
    private string? _erroFinalizacao;
    private readonly System.Globalization.CultureInfo _culturaBr = new("pt-BR");
    private VendaDto _dto = new();
    private List<ClienteListDto> _clientes = new();
    private List<CondicaoPagamentoListDto> _condicoes = new();
    private List<ProdutoListDto> _produtos = new();
    private readonly Dictionary<VendaItemDto, List<ProdutoVariacaoDto>> _variacoesPorItem = new();
    private readonly Dictionary<VendaItemDto, ProdutoListDto?> _produtosSelecionados = new();
    private readonly Dictionary<VendaItemDto, decimal> _custoPorItem = new();
    private readonly Dictionary<VendaItemDto, DateTime?> _dataCompraPorItem = new();

    private bool VariacaoDesabilitada(VendaItemDto item) =>
        Leitura || _produtosSelecionados.GetValueOrDefault(item) == null
        || !_variacoesPorItem.TryGetValue(item, out var vars) || vars.Count == 0;

    private static int GetEstoqueVar(List<ProdutoVariacaoDto> vars, int id)
        => vars.FirstOrDefault(v => v.IdOriginal == id)?.QuantidadeEstoque ?? 0;

    private void OnClienteAlterado(int? clienteId)
    {
        _dto.ClienteId = clienteId;
        if (!clienteId.HasValue)
        {
            _dto.CondicaoPagamentoId = null;
            _dto.DescontoPercentualAplicado = 0;
        }
        RecalcularTotais();
    }

    private void AdicionarItem()
    {
        if (Leitura || !CabecalhoValido) return;
        var item = new VendaItemDto();
        _dto.Itens.Add(item);
        _produtosSelecionados[item] = null;
        _variacoesPorItem[item] = new();
        StateHasChanged();
    }
    private void RemoverItem(VendaItemDto item)
    {
        _dto.Itens.Remove(item);
        _produtosSelecionados.Remove(item);
        _variacoesPorItem.Remove(item);
        _custoPorItem.Remove(item);
        _dataCompraPorItem.Remove(item);
        RecalcularTotais();
        StateHasChanged();
    }

    private async Task OnProdutoAlterado(VendaItemDto item, ProdutoListDto? produto)
    {
        _produtosSelecionados[item] = produto;
        item.ProdutoVariacaoId = 0; item.NomeProduto = produto?.Produto ?? "";
        item.Cor = ""; item.Tamanho = "";
        _custoPorItem[item] = 0; _dataCompraPorItem[item] = null;
        _variacoesPorItem[item] = produto != null ? await CarregarVariacoesComEstoque(produto.Id) : new();
        StateHasChanged();
    }
    private async Task<List<ProdutoVariacaoDto>> CarregarVariacoesComEstoque(int produtoId)
    {
        var dto = await ProdutoService.ObterPorIdAsync(produtoId);
        return dto?.Variacoes.Where(v => v.Ativo && v.QuantidadeEstoque > 0).ToList() ?? new();
    }
    private void OnVariacaoAlterada(VendaItemDto item, int variacaoId)
    {
        item.ProdutoVariacaoId = variacaoId;
        if (_variacoesPorItem.TryGetValue(item, out var vars))
        {
            var v = vars.FirstOrDefault(x => x.IdOriginal == variacaoId);
            if (v != null)
            {
                item.Cor = v.Cor;
                item.Tamanho = v.Tamanho;
                item.ValorUnitario = v.Preco;
                _custoPorItem[item] = v.PrecoCusto;
                _dataCompraPorItem[item] = v.DataUltimaCompra;
            }
        }
        RecalcularTotais();
        StateHasChanged();
    }
    private void OnQtdAlterada(VendaItemDto item, string? v)
    {
        var d = DocumentoHelper.SomenteDigitos(v);
        item.Quantidade = int.TryParse(d, out int n) && n > 0 ? n : 0;
        RecalcularTotais();
    }
    private void OnValorAlterado(VendaItemDto item, decimal valor)
    {
        item.ValorUnitario = Math.Max(valor, 0);
        RecalcularTotais();
    }
    private string? ErroQuantidade(VendaItemDto item)
    {
        if (Leitura || item.ProdutoVariacaoId == 0 || !_variacoesPorItem.TryGetValue(item, out var vars)) return null;
        var estoque = GetEstoqueVar(vars, item.ProdutoVariacaoId);
        var total = _dto.Itens.Where(i => !i.Removido && i.ProdutoVariacaoId == item.ProdutoVariacaoId).Sum(i => i.Quantidade);
        return total > estoque ? $"Disponível: {estoque} un." : null;
    }
    private Task<IEnumerable<ProdutoListDto>> PesquisarProduto(string? busca, CancellationToken ct)
    {
        var r = string.IsNullOrWhiteSpace(busca) ? _produtos.Take(50) : _produtos.Where(p => p.Produto.Contains(busca, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r);
    }
    private void OnDescontoPercentualAlterado(decimal v)
    {
        _dto.DescontoPercentualAplicado = Math.Clamp(v, 0, 100);
        RecalcularTotais();
    }
    private void RecalcularTotais()
    {
        _dto.ValorSubtotal = _dto.Itens.Sum(i => i.ValorTotal);
        var cond = _condicoes.FirstOrDefault(c => c.Id == _dto.CondicaoPagamentoId);
        var desc = _dto.ValorSubtotal * (_dto.DescontoPercentualAplicado / 100m);
        var acr = cond != null ? _dto.ValorSubtotal * (cond.AcrescimoPercentual / 100m) : 0m;
        _dto.ValorDesconto = desc - acr;
        _dto.ValorTotal = _dto.ValorSubtotal - _dto.ValorDesconto;
    }

    private async Task PesquisarCliente()
    {
        var cliente = await DialogService.PesquisarClienteAsync(ClienteService, _dto.ClienteId, NovoCliente);
        if (cliente == null) return;
        OnClienteAlterado(_clientes.ObterOuAdicionar(cliente, c => c.Id).Id);
    }

    private async Task PesquisarCondicao()
    {
        var condicao = await DialogService.PesquisarCondicaoPagamentoAsync(CondicaoPagamentoService, _dto.CondicaoPagamentoId, NovaCondicao);
        if (condicao == null) return;
        var c = _condicoes.ObterOuAdicionar(condicao, x => x.Id);
        _dto.CondicaoPagamentoId = c.Id;
        _dto.DescontoPercentualAplicado = c.DescontoPercentual;
        RecalcularTotais();
    }

    private async Task PesquisarProdutoItem(VendaItemDto item)
    {
        var produto = await DialogService.PesquisarProdutoAsync(ProdutoService, _produtosSelecionados.GetValueOrDefault(item)?.Id, somenteComEstoque: true);
        if (produto == null) return;
        await OnProdutoAlterado(item, _produtos.ObterOuAdicionar(produto, p => p.Id));
    }

    private async Task PesquisarVariacaoItem(VendaItemDto item)
    {
        var produto = _produtosSelecionados.GetValueOrDefault(item);
        if (produto == null) return;
        var variacao = await DialogService.PesquisarVariacaoAsync(ProdutoService, produto.Id, true, item.ProdutoVariacaoId > 0 ? item.ProdutoVariacaoId : null);
        if (variacao == null) return;
        if (!_variacoesPorItem.TryGetValue(item, out var vars) || vars.All(v => v.IdOriginal != variacao.Id))
            _variacoesPorItem[item] = await CarregarVariacoesComEstoque(produto.Id);
        OnVariacaoAlterada(item, variacao.Id);
    }

    private async Task<ClienteListDto?> NovoCliente()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroCliente>("Novo Cliente", opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        _clientes = (await ClienteService.ObterTodosAtivosAsync()).ToList();
        return _clientes.FirstOrDefault(c => c.Id == id);
    }

    private async Task<CondicaoPagamentoListDto?> NovaCondicao()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroCondicaoPagamento>("Nova Condição de Pagamento", opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        _condicoes = (await CondicaoPagamentoService.ObterTodosAtivosAsync()).ToList();
        return _condicoes.FirstOrDefault(c => c.Id == id);
    }
    private decimal CustoDoItem(VendaItemDto item) => _custoPorItem.TryGetValue(item, out var custo) ? custo : 0;

    private bool AbaixoDoCusto(VendaItemDto item)
    {
        var custo = CustoDoItem(item);
        return custo > 0 && item.ValorUnitario > 0 && item.ValorUnitario < custo;
    }

    private string? GetAlertaFastFashion(VendaItemDto item)
    {
        if (!AbaixoDoCusto(item)) return null;
        _dataCompraPorItem.TryGetValue(item, out var dataCompra);
        bool fastFashion = dataCompra.HasValue && (DateTime.Today - dataCompra.Value).TotalDays > 90;
        return fastFashion ? "aviso" : "bloquear";
    }

    private string? ErroAntesDeGravar()
    {
        if (!CabecalhoValido) return "Selecione o cliente e a condição de pagamento.";
        if (_dto.Itens.Count == 0) return "Adicione pelo menos um item.";
        foreach (var item in _dto.Itens)
        {
            if (GetAlertaFastFashion(item) == "bloquear")
            {
                _custoPorItem.TryGetValue(item, out var custo);
                return $"{item.NomeProduto} {item.Cor}/{item.Tamanho}: preço de venda (R$ {item.ValorUnitario:N2}) " +
                       $"abaixo do custo (R$ {custo:N2}). Produto com menos de 90 dias no estoque.";
            }
            var erroQtd = ErroQuantidade(item);
            if (erroQtd != null) return $"{item.NomeProduto} {item.Cor}/{item.Tamanho}: quantidade maior que o estoque. {erroQtd}";
        }
        return null;
    }

    private async Task Salvar()
    {
        if (Leitura) return;
        var erro = ErroAntesDeGravar();
        if (erro != null) { Snackbar.Add(erro, Severity.Warning); return; }

        _salvando = true;
        var (sucesso, mensagem, _) = await VendaService.SalvarAsync(_dto);
        _salvando = false;
        Snackbar.Add(mensagem, sucesso ? Severity.Success : Severity.Error);
        if (sucesso) MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task FinalizarVenda()
    {
        if (Leitura) return;
        _erroFinalizacao = ErroAntesDeGravar();
        if (_erroFinalizacao != null) return;

        _salvando = true;
        var (sucesso, mensagem, id) = await VendaService.SalvarEFinalizarAsync(_dto);
        _salvando = false;
        if (sucesso)
        {
            Snackbar.Add(mensagem, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }
        if (id > 0)
        {
            _dto.Id = id;
            _dto.IdOriginal = id;
            _gravada = true;
            _snapshot = DialogServiceExtensions.Snapshot(_dto);
        }
        _erroFinalizacao = mensagem;
    }

    private async Task Fechar()
    {
        if (_gravada && _snapshot == DialogServiceExtensions.Snapshot(_dto)) { MudDialog.Close(DialogResult.Ok(true)); return; }
        await DialogService.FecharComConfirmacaoAsync(MudDialog, Leitura, _snapshot, _dto);
    }
}
