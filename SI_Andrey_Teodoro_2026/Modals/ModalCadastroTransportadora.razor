@inject ITransportadoraService TransportadoraService
@inject ICidadeService CidadeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@(_readOnly ? "Detalhes da Transportadora" : Edicao ? "Editar Transportadora" : "Cadastrar Nova Transportadora")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValido">
            <MudGrid Spacing="2">
                <TituloSecao Grupos="_grupos" Grupo="1" Icone="@Icons.Material.Filled.Badge" Titulo="Identificação" AoMudar="StateHasChanged" />
                <MudItem xs="12" sm="2">
                    <MudNumericField T="int" Value="_dto.Id" ValueChanged="@((int v) => { _dto.Id = v; Alterou(1); })"
                                     Label="ID" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" HideSpinButtons="true" FullWidth="true"
                                     Validation="@((int v) => v <= 0 ? "ID deve ser maior que zero" : null)"
                                     Disabled="@(_dto.IdOriginal > 0 || Bloqueado(1))" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_cnpjTexto" ValueChanged="@((string v) => { _cnpjTexto = MascaraCnpj(v); _dto.Cnpj = _cnpjTexto; Alterou(1); })"
                                  Label="CNPJ" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="18" FullWidth="true" Immediate="true"
                                  Validation="@((string v) => DocumentoHelper.ValidarCnpj(v))"
                                  Disabled="@(Edicao || Bloqueado(1))" HelperText="@AjudaTravado" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.RazaoSocial" ValueChanged="@((string v) => { _dto.RazaoSocial = v; Alterou(1); })" Label="Razão Social" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="100" FullWidth="true"
                                  Disabled="@(Bloqueado(1) || !Edicao && !CnpjOk)" HelperText="@AjudaRazao" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.NomeFantasia" ValueChanged="@((string? v) => { _dto.NomeFantasia = v; Alterou(1); })" Label="Nome Fantasia" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" FullWidth="true" Disabled="@(Bloqueado(1) || !Edicao && !RazaoOk)" HelperText="@AjudaRestante" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.InscricaoEstadual" ValueChanged="@((string v) => { _dto.InscricaoEstadual = v; Alterou(1); })" Label="Inscrição Estadual"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="30" FullWidth="true" Immediate="true" Disabled="@(Bloqueado(1) || !Edicao && !RazaoOk)" HelperText="@AjudaRestante" />
                </MudItem>

                <TituloSecao Grupos="_grupos" Grupo="2" Icone="@Icons.Material.Filled.Place" Titulo="Endereço" AoMudar="StateHasChanged" />
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center gap-1">
                        <MudAutocomplete T="CidadeListDto"
                                         Value="_cidadeSelecionada"
                                         ValueChanged="OnCidadeAlterada"
                                         SearchFunc="PesquisarCidade"
                                         ToStringFunc="@(c => c == null ? "" : $"{c.NomeCidade} — {c.Uf}")"
                                         Label="Cidade" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Required="true" RequiredError="Obrigatório"
                                         FullWidth="true" Clearable="true" ResetValueOnEmptyText="true"
                                         CoerceText="false" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                        <MudTooltip Text="Pesquisar cidade">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Small"
                                           OnClick="PesquisarCidadeModal" Disabled="@Bloqueado(2)" />
                        </MudTooltip>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_dto.Endereco" ValueChanged="@((string v) => { _dto.Endereco = v; Alterou(2); })" Label="Endereço" Immediate="true"
                                  Required="true" RequiredError="Obrigatório"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" FullWidth="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudTextField Value="@_dto.Numero" ValueChanged="@((string v) => { _dto.Numero = v; Alterou(2); })" Label="Número" Immediate="true"
                                  Required="true" RequiredError="Obrigatório"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="10" FullWidth="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_dto.Bairro" ValueChanged="@((string v) => { _dto.Bairro = v; Alterou(2); })" Label="Bairro" Immediate="true"
                                  Required="true" RequiredError="Obrigatório"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="60" FullWidth="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_dto.Complemento" ValueChanged="@((string v) => { _dto.Complemento = v; Alterou(2); })" Label="Complemento" Immediate="true"
                                  Required="true" RequiredError="Obrigatório"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" FullWidth="true" Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@_dto.Cep" ValueChanged="@((string v) => { _dto.Cep = MascaraCep(v); Alterou(2); })"
                                  Label="CEP" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Obrigatório"
                                  MaxLength="9" FullWidth="true" Immediate="true" Validation="@((string v) => DocumentoHelper.ValidarCep(v))"
                                  Disabled="@Bloqueado(2)" HelperText="@AjudaGrupo(2)" />
                </MudItem>

                <TituloSecao Grupos="_grupos" Grupo="3" Icone="@Icons.Material.Filled.ContactPhone" Titulo="Contato" AoMudar="StateHasChanged" />
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.Telefone" ValueChanged="@((string v) => { _dto.Telefone = MascaraTel(v); Alterou(3); })" Label="Telefone"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="15" FullWidth="true" Immediate="true"
                                  Validation="@((string v) => ValidarTelefone(v))" Disabled="@Bloqueado(3)" HelperText="@AjudaGrupo(3)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_dto.Email" ValueChanged="@((string v) => { _dto.Email = v; Alterou(3); })" Label="E-mail" Class="sem-maiusculas"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" RequiredError="Obrigatório" MaxLength="100" FullWidth="true" Immediate="true"
                                  Validation="@((string v) => ValidarEmail(v))"
                                  InputType="InputType.Email" Disabled="@Bloqueado(3)" HelperText="@AjudaGrupo(3)" />
                </MudItem>
            </MudGrid>
        </MudForm>
        @if (_dto.AtualizadoEm.HasValue)
        {
            <MudText Style="font-size:0.75rem;color:#999;text-align:right;display:block;margin-top:8px;">
                Alterado em @_dto.AtualizadoEm.Value.ToString("dd/MM/yyyy HH:mm")
                @if (!string.IsNullOrWhiteSpace(_dto.NomeAtualizadoPor))
                {
                    <text> por @_dto.NomeAtualizadoPor</text>
                }
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (_readOnly)
        {
            <MudButton Variant="Variant.Outlined" OnClick="Fechar">Fechar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _readOnly = false)" StartIcon="@Icons.Material.Filled.Edit">
                Editar
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" OnClick="Fechar">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Salvar"
                       Disabled="@(_salvando || _grupos.Editando.HasValue)" StartIcon="@Icons.Material.Filled.Save"
                       Style="font-weight:700;min-width:120px;">
                @(_salvando ? "Salvando..." : "SALVAR")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private string? _snapshot;
    [Parameter] public TransportadoraDto? DtoEdicao { get; set; }
    [Parameter] public bool SomenteLeitura { get; set; } = false;

    private bool _readOnly;
    private MudForm? _form;
    private bool _formValido, _salvando;
    private string _cnpjTexto = "";
    private TransportadoraDto _dto = new();
    private List<CidadeListDto> _cidades = new();
    private CidadeListDto? _cidadeSelecionada;
    private GruposProgressivos _grupos = null!;
    private bool? _readOnlyTitulo;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_readOnlyTitulo == _readOnly) return;
        var jaRenderizado = _readOnlyTitulo.HasValue;
        _readOnlyTitulo = _readOnly;
        if (jaRenderizado) MudDialog.StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _readOnly = SomenteLeitura;
        _grupos = new(() => !_readOnly && !Edicao, ErroGrupo, "a identificação", "o endereço");
        _dto = DtoEdicao ?? new TransportadoraDto();
        _dto.Telefone = MascaraTel(_dto.Telefone);
        _cnpjTexto = _dto.Cnpj ?? "";
        _cidades = (await CidadeService.ObterTodosAtivosSemPaginacaoAsync()).ToList();
        await _cidades.IncluirSeAusenteAsync(_dto.CidadeId, c => c.Id, async id => await CidadeService.ObterPorIdAsync(id) is { } c ? new CidadeListDto { Id = c.Id, NomeCidade = c.NomeCidade, EstadoId = c.EstadoId, PaisId = c.PaisId, Uf = c.Uf } : null);
        if (_dto.CidadeId.HasValue)
            _cidadeSelecionada = _cidades.FirstOrDefault(c => c.Id == _dto.CidadeId);
        if (_dto.IdOriginal == 0) _dto.Id = await TransportadoraService.ObterProximoIdAsync();
        _snapshot = DialogServiceExtensions.Snapshot(DadosEditaveis());
    }

    private void OnCidadeAlterada(CidadeListDto? cidade)
    {
        if (cidade?.Id == _dto.CidadeId) return;
        _cidadeSelecionada = cidade;
        _dto.CidadeId = cidade?.Id;
        Alterou(2);
    }

    private Task<IEnumerable<CidadeListDto>> PesquisarCidade(string? busca, CancellationToken ct)
    {
        var r = string.IsNullOrWhiteSpace(busca)
            ? _cidades.Take(50)
            : _cidades.Where(c => c.NomeCidade.Contains(busca, StringComparison.OrdinalIgnoreCase)
                               || c.Uf.Contains(busca, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(r);
    }

    private async Task PesquisarCidadeModal()
    {
        var cidade = await DialogService.PesquisarCidadeAsync(CidadeService, _dto.CidadeId, NovaCidade);
        if (cidade == null) return;
        OnCidadeAlterada(_cidades.ObterOuAdicionar(cidade, c => c.Id));
    }

    private async Task<CidadeListDto?> NovaCidade()
    {
        var opts = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCadastroCidade>("Nova Cidade", opts);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not int id) return null;
        var todas = (await CidadeService.ObterTodosAtivosSemPaginacaoAsync()).ToList();
        _cidades = todas;
        return todas.FirstOrDefault(c => c.Id == id);
    }

    private async Task Salvar()
    {
        await _form!.Validate();
        if (!_formValido) return;
        _salvando = true;
        var (sucesso, mensagem, id) = await TransportadoraService.SalvarAsync(_dto);
        _salvando = false;
        Snackbar.Add(mensagem, sucesso ? Severity.Success : Severity.Error);
        if (sucesso) MudDialog.Close(DialogResult.Ok(id));
    }

    private bool Edicao => _dto.IdOriginal > 0;
    private string? AjudaTravado => Edicao && !_readOnly ? "Não pode ser alterado após o cadastro." : null;
    private bool CnpjOk => Edicao || DocumentoHelper.CnpjValido(_dto.Cnpj);
    private bool RazaoOk => CnpjOk && !string.IsNullOrWhiteSpace(_dto.RazaoSocial);
    private bool Bloqueado(int g) => _readOnly || _grupos.Bloqueado(g);
    private string? AjudaGrupo(int g) => _grupos.Ajuda(g);
    private void Alterou(int g) => _grupos.Alterou(g);
    private string? ErroGrupo(int g) => g switch
    {
        1 when !CnpjOk => "Informe um CNPJ válido.",
        1 when !RazaoOk => "Informe a razão social.",
        2 when !_dto.CidadeId.HasValue => "Selecione a cidade.",
        2 when string.IsNullOrWhiteSpace(_dto.Endereco) => "Informe o endereço.",
        2 when string.IsNullOrWhiteSpace(_dto.Numero) => "Informe o número.",
        2 when string.IsNullOrWhiteSpace(_dto.Bairro) => "Informe o bairro.",
        2 when string.IsNullOrWhiteSpace(_dto.Complemento) => "Informe o complemento.",
        2 when string.IsNullOrWhiteSpace(_dto.Cep) => "Informe o CEP.",
        2 when !DocumentoHelper.CepValido(_dto.Cep) => "CEP incompleto.",
        3 when ValidarTelefone(_dto.Telefone) is string erro => $"Telefone: {erro}.",
        3 when ValidarEmail(_dto.Email) is string erro => $"E-mail: {erro}.",
        _ => null
    };
    private static string? ValidarTelefone(string? v) { var d = new string(v?.Where(char.IsDigit).ToArray() ?? Array.Empty<char>()); return d.Length switch { 10 => null, 11 => null, < 10 => "Incompleto", _ => "Máx 11 dígitos" }; }
    private string? AjudaRazao => Edicao || CnpjOk ? null : "Informe um CNPJ válido primeiro.";
    private string? AjudaRestante => Edicao || RazaoOk ? null : AjudaRazao ?? "Informe a razão social primeiro.";
    private object DadosEditaveis() => new { _dto, _cnpjTexto, Cidade = _cidadeSelecionada?.Id };
    private Task Fechar() => DialogService.FecharComConfirmacaoAsync(MudDialog, _readOnly, _snapshot, DadosEditaveis());

    private string MascaraTel(string? v) { if (string.IsNullOrEmpty(v)) return ""; var d = new string(v.Where(char.IsDigit).ToArray()); if (d.Length > 11) d = d[..11]; return d.Length switch { 0 => "", <= 2 => $"({d}", <= 6 => $"({d[..2]}) {d[2..]}", <= 10 => $"({d[..2]}) {d[2..6]}-{d[6..]}", _ => $"({d[..2]}) {d[2..7]}-{d[7..]}" }; }
    private string MascaraCnpj(string? v) { if (string.IsNullOrEmpty(v)) return ""; var d = new string(v.Where(char.IsDigit).ToArray()); if (d.Length > 14) d = d[..14]; return d.Length switch { 0 => "", <= 2 => d, <= 5 => $"{d[..2]}.{d[2..]}", <= 8 => $"{d[..2]}.{d[2..5]}.{d[5..]}", <= 12 => $"{d[..2]}.{d[2..5]}.{d[5..8]}/{d[8..]}", _ => $"{d[..2]}.{d[2..5]}.{d[5..8]}/{d[8..12]}-{d[12..]}" }; }

    private string MascaraCep(string? v)
    {
        if (string.IsNullOrEmpty(v)) return "";
        var d = new string(v.Where(char.IsDigit).ToArray());
        if (d.Length > 8) d = d[..8];
        return d.Length <= 5 ? d : $"{d[..5]}-{d[5..]}";
    }

    private static string? ValidarEmail(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return "Obrigatório";
        return System.Text.RegularExpressions.Regex.IsMatch(v, @"^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$") ? null : "E-mail inválido";
    }
}
