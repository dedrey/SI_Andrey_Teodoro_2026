@if (TotalItens > 0)
{
    <div class="d-flex justify-center align-center gap-2 mt-4 flex-wrap">
        @if (TotalPaginas > 1)
        {
            <MudIconButton Icon="@Icons.Material.Filled.FirstPage"
                           Disabled="@(PaginaAtual <= 1)"
                           OnClick="@(() => MudarPagina(1))" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Disabled="@(PaginaAtual <= 1)"
                           OnClick="@(() => MudarPagina(PaginaAtual - 1))" />

            @foreach (var pagina in PaginasVisiveis)
            {
                <MudButton Variant="@(pagina == PaginaAtual ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="@(() => MudarPagina(pagina))">
                    @pagina
                </MudButton>
            }

            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Disabled="@(PaginaAtual >= TotalPaginas)"
                           OnClick="@(() => MudarPagina(PaginaAtual + 1))" />
            <MudIconButton Icon="@Icons.Material.Filled.LastPage"
                           Disabled="@(PaginaAtual >= TotalPaginas)"
                           OnClick="@(() => MudarPagina(TotalPaginas))" />
        }

        <MudText Typo="Typo.body2" Class="align-self-center ml-2">
            Página @PaginaAtual de @Math.Max(TotalPaginas, 1) | Total: @TotalItens registros
        </MudText>

        <div style="width:110px;" class="ml-2">
            <MudSelect T="int" Value="TamanhoPagina" ValueChanged="MudarTamanho" Label="Por página"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                @foreach (var tamanho in Tamanhos)
                {
                    <MudSelectItem T="int" Value="@tamanho">@tamanho</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>
}

@code {
    [Parameter] public int PaginaAtual   { get; set; }
    [Parameter] public int TotalPaginas  { get; set; }
    [Parameter] public int TotalItens    { get; set; }
    [Parameter] public int TamanhoPagina { get; set; }
    [Parameter] public EventCallback<int> OnPaginaMudou { get; set; }
    [Parameter] public EventCallback<int> OnTamanhoMudou { get; set; }

    private static readonly int[] Tamanhos = { 10, 25, 50 };

    private IEnumerable<int> PaginasVisiveis
    {
        get
        {
            var inicio = Math.Max(1, PaginaAtual - 2);
            var fim    = Math.Min(TotalPaginas, PaginaAtual + 2);
            return Enumerable.Range(inicio, fim - inicio + 1);
        }
    }

    private async Task MudarPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalPaginas && pagina != PaginaAtual)
            await OnPaginaMudou.InvokeAsync(pagina);
    }

    private async Task MudarTamanho(int tamanho)
    {
        if (tamanho != TamanhoPagina)
            await OnTamanhoMudou.InvokeAsync(tamanho);
    }
}